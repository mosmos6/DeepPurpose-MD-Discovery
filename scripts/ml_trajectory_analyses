def run_contact_analysis_rna_multi(traj_file, top_file, registry, base_prefix=""):
    for info in registry.values():
        run_contact_analysis_rna(traj_file, top_file, ligand_info=info,
                                 ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix))

def run_contact_analysis_protein_multi(traj_file, top_file, registry, base_prefix=""):
    for info in registry.values():
        run_contact_analysis_protein(traj_file, top_file, ligand_info=info,
                                     ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix))

def run_hbond_analysis_rna_multi(traj_file, top_file, registry, base_prefix="", dist_cutoff=0.35, angle_cutoff=120.0):
    for info in registry.values():
        run_hbond_analysis_rna(traj_file, top_file, ligand_info=info,
                               ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix),
                               dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff)

def run_hbond_analysis_protein_multi(traj_file, top_file, registry, base_prefix="", dist_cutoff=0.35, angle_cutoff=120.0):
    for info in registry.values():
        run_hbond_analysis_protein(traj_file, top_file, ligand_info=info,
                                   ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix),
                                   dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff)

def run_ligand_rna_atom_contact_frequencies_multi(traj_file, top_file, registry, base_prefix=""):
    for info in registry.values():
        run_ligand_rna_atom_contact_frequencies_safe(traj_file, top_file, ligand_info=info,
                                                     ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix))

def run_carboxylate_OP_checker_multi(traj_file, top_file, registry, base_prefix="carboxylate_OP_"):
    for info in registry.values():
        run_carboxylate_OP_checker(traj_file, top_file, ligand_info=info,
                                   ligand_resname="UNK", out_prefix=_ligand_prefix(info, base_prefix))

