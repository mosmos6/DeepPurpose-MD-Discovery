# ===========================
# BIG SURGERY – MULTI‑LIGAND
# ===========================
import jax.numpy as jnp
import numpy as np
import matplotlib.pyplot as plt
import mdtraj as md
from tqdm import tqdm
import seaborn as sns
import pandas as pd
import builtins
from collections import defaultdict, Counter
from sklearn.decomposition import PCA
from scipy.constants import Boltzmann

# -------------------------------
# Universal multi‑ligand helpers
# -------------------------------
from dataclasses import dataclass
from typing import Dict, List, Optional, Iterable, Tuple

@dataclass
class LigandEntry:
    label: str            # e.g., "GMP" or fallback "UNK_B1"
    resname: str          # "UNK" (or actual)
    chain_index: int      # mdtraj chain.index (int; stable)
    chain_id: str         # PDB chain ID if available; else str(index)
    resSeq: int           # PDB residue number
    atom_indices: np.ndarray  # sorted atom indices for this ligand instance

def _safe_label(s: str) -> str:
    return "".join(ch if ch.isalnum() or ch in ("-", "_") else "_" for ch in str(s))

def build_ligand_registry(top_file: str,
                          target_resnames: Tuple[str, ...] = ("UNK",),
                          name_hints: Optional[Dict[Tuple[str, int], str]] = None,
                          print_summary: bool = True) -> Dict[str, LigandEntry]:
    """
    Scan the topology, find every residue whose name is in target_resnames,
    and register each UNK instance separately by (chain, resSeq).
    Optionally override labels via name_hints: { (chain_id, resSeq) : "GMP" }.
    """
    t = md.load(top_file)  # PDB/PSF etc.
    reg: Dict[str, LigandEntry] = {}
    name_hints = name_hints or {}

    for res in t.topology.residues:
        resname = res.name.strip()
        if resname not in target_resnames:
            continue
        # Chain identity for human-friendly label
        cid = getattr(res.chain, "id", None)
        if cid is None or (isinstance(cid, str) and cid.strip() == ""):
            cid = str(getattr(res.chain, "index", 0))
        cid = str(cid)
        resSeq = int(res.resSeq)
        atoms = [a.index for a in res.atoms]
        if not atoms:
            continue
        atoms = np.array(sorted(atoms), dtype=int)

        # Determine label from hints; otherwise fallback
        hint = name_hints.get((cid, resSeq))
        label = hint if hint else f"{resname}_{cid}{resSeq}"
        label = _safe_label(label)

        entry = LigandEntry(label=label,
                            resname=resname,
                            chain_index=int(res.chain.index),
                            chain_id=cid,
                            resSeq=resSeq,
                            atom_indices=atoms)
        reg[label] = entry

    if print_summary:
        if not reg:
            print("❗ No ligand residues matching", target_resnames, "were found.")
        else:
            print("Ligand registry (per‑residue UNK instance):")
            for key in sorted(reg.keys()):
                e = reg[key]
                print(f"  - {key:<12} → {e.resname}  chain {e.chain_id}  resSeq {e.resSeq}  (atoms: {len(e.atom_indices)})")
    return reg

def for_each_ligand(registry: Dict[str, LigandEntry],
                    only: Optional[Iterable[str]] = None,
                    exclude: Optional[Iterable[str]] = None) -> Iterable[LigandEntry]:
    """
    Iterate registered ligands, optionally filtering by names.
    """
    only_set = set(only) if only else None
    excl_set = set(exclude) if exclude else set()
    for key in sorted(registry.keys()):
        if key in excl_set:
            continue
        if (only_set is not None) and (key not in only_set):
            continue
        yield registry[key]

# Enhanced selector – now instance-aware
def get_ligand_atoms(traj: md.Trajectory,
                     ligand_resname: str = "UNK",
                     chain_index: Optional[int] = None,
                     resSeq: Optional[int] = None,
                     atom_indices: Optional[Iterable[int]] = None) -> List[int]:
    """
    Backward compatible:
      - If only ligand_resname is given -> returns all atoms with that resname (legacy behavior).
      - If chain_index & resSeq provided -> returns atoms for that specific residue instance.
      - If atom_indices provided -> returns that list (preferred when available).
    """
    if atom_indices is not None:
        return list(map(int, atom_indices))

    if chain_index is None and resSeq is None:
        return [a.index for a in traj.topology.atoms
                if a.residue.name.strip() == ligand_resname]

    out = []
    for a in traj.topology.atoms:
        r = a.residue
        if r.name.strip() != ligand_resname:
            continue
        if (chain_index is not None) and (int(r.chain.index) != int(chain_index)):
            continue
        if (resSeq is not None) and (int(r.resSeq) != int(resSeq)):
            continue
        out.append(a.index)
    return out

# Utility: RMSD with Kabsch in JAX (for ligand RMSD; replaces md.rmsd)
def _rmsd_kabsch_to_ref_series(coords: jnp.ndarray, ref: jnp.ndarray) -> np.ndarray:
    """
    coords: (F, N, 3), ref: (N, 3)
    Returns per-frame RMSD (nm) after optimal superposition (Kabsch).
    """
    # Center
    X = coords - jnp.mean(coords, axis=1, keepdims=True)
    Y = ref - jnp.mean(ref, axis=0, keepdims=True)

    # Covariance and rotation per-frame
    # For numerical stability we process in a Python loop (F typically << N)
    F = int(X.shape[0])
    out = np.zeros(F, dtype=float)
    for f in range(F):
        C = X[f].T @ Y
        U, S, Vt = jnp.linalg.svd(C, full_matrices=False)
        R = U @ Vt
        # Reflection fix
        if jnp.linalg.det(R) < 0:
            R = U @ jnp.diag(jnp.array([1.0, 1.0, -1.0])) @ Vt
        Xr = X[f] @ R
        diff = Xr - Y
        out[f] = float(jnp.sqrt(jnp.mean(jnp.sum(diff*diff, axis=1))))
    return out

# -----------------------------
# 1. Global RMSD (Overlay) – unchanged (not ligand-specific)
# -----------------------------
def run_rmsd_overlay(traj_apo_file, top_apo_file, traj_holo_file, top_holo_file, out_prefix=""):
    traj_apo = md.load_dcd(traj_apo_file, top=top_apo_file)
    traj_holo = md.load_dcd(traj_holo_file, top=top_holo_file)
    exclude = {"HOH", "NA", "CL"}
    valid_atoms_apo = [i for i, a in enumerate(traj_apo.topology.atoms) if a.residue.name.strip() not in exclude]
    valid_atoms_holo = [i for i, a in enumerate(traj_holo.topology.atoms) if a.residue.name.strip() not in exclude]
    coords_apo = jnp.array(traj_apo.xyz)[:, valid_atoms_apo, :]
    coords_holo = jnp.array(traj_holo.xyz)[:, valid_atoms_holo, :]
    ref_xyz_apo = coords_apo[0]
    ref_xyz_holo = coords_holo[0]
    def compute_rmsd(coords, ref):
        return jnp.sqrt(jnp.mean(jnp.square(coords - ref), axis=(1,2)))
    rmsd_apo = compute_rmsd(coords_apo, ref_xyz_apo)
    rmsd_holo = compute_rmsd(coords_holo, ref_xyz_holo)
    plt.figure(figsize=(10, 4))
    plt.plot(rmsd_apo, label="Apo (no ligand)")
    plt.plot(rmsd_holo, label="Ligand-bound")
    plt.xlabel("Frame")
    plt.ylabel("RMSD (nm)")
    plt.title("Global RMSD: Apo vs Ligand-bound (JAX)")
    plt.legend()
    plt.tight_layout()
    fname = f"{out_prefix}rmsd_overlay.png"
    plt.savefig(fname)
    print(f"✅ RMSD overlay saved as {fname}")

# -----------------------------
# 2. Global RMSF (Overlay) – unchanged (not ligand-specific)
# -----------------------------
def run_rmsf_overlay(traj_apo_file, top_apo_file, traj_holo_file, top_holo_file, out_prefix=""):
    traj_apo = md.load_dcd(traj_apo_file, top=top_apo_file)
    traj_holo = md.load_dcd(traj_holo_file, top=top_holo_file)
    exclude = {"HOH", "NA", "CL"}
    valid_atoms_apo = [i for i, a in enumerate(traj_apo.topology.atoms) if a.residue.name.strip() not in exclude]
    valid_atoms_holo = [i for i, a in enumerate(traj_holo.topology.atoms) if a.residue.name.strip() not in exclude]
    coords_apo = jnp.array(traj_apo.xyz)[:, valid_atoms_apo, :]
    coords_holo = jnp.array(traj_holo.xyz)[:, valid_atoms_holo, :]
    avg_xyz_apo = jnp.mean(coords_apo, axis=0)
    avg_xyz_holo = jnp.mean(coords_holo, axis=0)
    rmsf_apo = jnp.sqrt(jnp.mean(jnp.sum((coords_apo - avg_xyz_apo[None, :, :])**2, axis=2), axis=0))
    rmsf_holo = jnp.sqrt(jnp.mean(jnp.sum((coords_holo - avg_xyz_holo[None, :, :])**2, axis=2), axis=0))
    plt.figure(figsize=(10, 4))
    plt.plot(rmsf_apo, label="Apo (no ligand)")
    plt.plot(rmsf_holo, label="Ligand-bound")
    plt.xlabel("Atom Index")
    plt.ylabel("RMSF (nm)")
    plt.title("Global RMSF: Apo vs Ligand-bound (JAX)")
    plt.legend()
    plt.tight_layout()
    fname = f"{out_prefix}rmsf_overlay.png"
    plt.savefig(fname)
    print(f"✅ RMSF overlay saved as {fname}")

# ---------------------------------------
# 3. Ligand RMSD (holo only) – multi‑ligand aware
# ---------------------------------------
def run_ligand_rmsd(traj_file, top_file,
                    ligand_resname="UNK", out_prefix="",
                    ligand_chain_index: Optional[int] = None,
                    ligand_resSeq: Optional[int] = None,
                    ligand_atom_indices: Optional[Iterable[int]] = None):
    traj = md.load_dcd(traj_file, top=top_file)
    ligand_atoms = get_ligand_atoms(traj, ligand_resname,
                                    chain_index=ligand_chain_index,
                                    resSeq=ligand_resSeq,
                                    atom_indices=ligand_atom_indices)
    if not ligand_atoms:
        print("❗ No ligand atoms found; skipping ligand RMSD.")
        return
    coords = jnp.array(traj.xyz)[:, ligand_atoms, :]       # (F, N, 3)
    ref = coords[0]                                        # (N, 3)
    ligand_rmsd = _rmsd_kabsch_to_ref_series(coords, ref)  # (F,)

    # Time axis: ns if available
    t_ns = (np.asarray(traj.time)/1000.0
            if getattr(traj, "time", None) is not None and len(traj.time) == coords.shape[0]
            else np.arange(coords.shape[0]))

    plt.figure(figsize=(8, 5))
    plt.plot(t_ns, ligand_rmsd, label="Ligand RMSD (nm)")
    plt.xlabel("Time (ns)"); plt.ylabel("RMSD (nm)"); plt.title("Ligand RMSD Over Time")
    plt.legend(); plt.grid(); plt.tight_layout()
    fname = f"{out_prefix}ligand_rmsd.png"
    plt.savefig(fname)
    print(f"✅ Ligand RMSD plot saved as {fname}")

def wrap_multi_ligand_rmsd(traj_file, top_file, registry, out_prefix=""):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_ligand_rmsd(traj_file, top_file,
                        ligand_resname=e.resname,
                        out_prefix=pfx,
                        ligand_chain_index=e.chain_index,
                        ligand_resSeq=e.resSeq,
                        ligand_atom_indices=e.atom_indices)

# ---------------------------------------
# 4. Hydration Shell – multi‑ligand aware
# ---------------------------------------
def run_hydration_shell(traj_file, top_file, ligand_resname="UNK", out_prefix="", dist_cutoff=0.35,
                        ligand_chain_index: Optional[int] = None,
                        ligand_resSeq: Optional[int] = None,
                        ligand_atom_indices: Optional[Iterable[int]] = None):
    traj = md.load_dcd(traj_file, top=top_file)
    ligand_atoms = get_ligand_atoms(traj, ligand_resname,
                                    chain_index=ligand_chain_index,
                                    resSeq=ligand_resSeq,
                                    atom_indices=ligand_atom_indices)
    if not ligand_atoms:
        print("❗ No ligand atoms found; hydration skipped.")
        return
    water_atoms = traj.topology.select("water")
    coords = jnp.array(traj.xyz)
    lig_xyz = coords[:, ligand_atoms, :]
    wat_xyz = coords[:, water_atoms, :]
    diff = lig_xyz[:, :, None, :] - wat_xyz[:, None, :, :]
    dists = jnp.linalg.norm(diff, axis=-1)            # (F, n_lig, n_wat)
    min_dists = jnp.min(dists, axis=1)               # (F, n_wat)
    hydration_counts = jnp.sum(min_dists < dist_cutoff, axis=1)
    plt.figure(figsize=(8, 5))
    plt.plot(np.arange(traj.n_frames), hydration_counts, label="Hydration Count (Water Bridges)")
    plt.xlabel("Frame"); plt.ylabel("Number of Water Molecules"); plt.title("Hydration Shell Around Ligand Over Time")
    plt.legend(); plt.grid(); plt.tight_layout()
    fname = f"{out_prefix}hydration_shell.png"
    plt.savefig(fname)
    print(f"✅ Hydration shell plot saved as {fname}")

def wrap_multi_hydration_shell(traj_file, top_file, registry, out_prefix="", dist_cutoff=0.35):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_hydration_shell(traj_file, top_file,
                            ligand_resname=e.resname,
                            out_prefix=pfx,
                            dist_cutoff=dist_cutoff,
                            ligand_chain_index=e.chain_index,
                            ligand_resSeq=e.resSeq,
                            ligand_atom_indices=e.atom_indices)

# -------------------------------------------------
# 5. Contact Analysis (RNA / Protein) – multi‑ligand aware
# -------------------------------------------------
def run_contact_analysis_rna(traj_file, top_file, ligand_resname="UNK", out_prefix="",
                             ligand_chain_index: Optional[int] = None,
                             ligand_resSeq: Optional[int] = None,
                             ligand_atom_indices: Optional[Iterable[int]] = None):
    import mdtraj as md
    import jax.numpy as jnp
    from tqdm import tqdm
    from collections import defaultdict
    import pandas as pd
    import builtins

    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    rna_base_names = {"A", "U", "G", "C", "DA", "DG", "DT", "DC", "DU"}

    ligand_atoms = get_ligand_atoms(traj, ligand_resname,
                                    chain_index=ligand_chain_index,
                                    resSeq=ligand_resSeq,
                                    atom_indices=ligand_atom_indices)
    if not ligand_atoms:
        print("❗ No ligand atoms found; contact analysis (RNA) skipped.")
        return
    rna_atoms = [atom.index for atom in traj.topology.atoms if atom.residue.name.strip() in rna_base_names]
    atom_to_res_obj = {atom.index: atom.residue for atom in traj.topology.atoms if atom.index in rna_atoms}
    atom_to_res_label = {atom.index: f"{atom.residue.name} {atom.residue.resSeq}" for atom in traj.topology.atoms if atom.index in rna_atoms}

    cutoff = 0.4  # nm = 4 Å
    residue_contact_counts = defaultdict(int)
    residue_frame_hits = defaultdict(set)
    residue_unique_labels = defaultdict(set)

    for frame_idx in tqdm(range(coords.shape[0]), desc="Processing frames (contact RNA)"):
        lig_xyz = coords[frame_idx, ligand_atoms]
        rna_xyz = coords[frame_idx, rna_atoms]
        diff = lig_xyz[:, None, :] - rna_xyz[None, :, :]
        dists = jnp.linalg.norm(diff, axis=-1)
        contacts = jnp.argwhere(dists < cutoff)
        for _, rna_idx in contacts:
            rna_index = int(rna_atoms[int(rna_idx)])
            res_obj = atom_to_res_obj[rna_index]
            res_label = atom_to_res_label[rna_index]
            residue_contact_counts[res_obj] += 1
            residue_frame_hits[res_obj].add(frame_idx)
            residue_unique_labels[res_label].add(frame_idx)

    if not residue_contact_counts:
        print("ℹ️ No RNA contacts detected.")
        return

    total_contacts = builtins.sum(residue_contact_counts.values())
    interaction_frequencies = {
        f"{res}": (count / total_contacts) * 100 for res, count in residue_contact_counts.items()
    }
    residence_times = {
        f"{res}": (len(frames) / traj.n_frames) * 100 for res, frames in residue_frame_hits.items()
    }

    residue_frame_counts = {label: len(frames) for label, frames in residue_unique_labels.items()}
    sorted_counts = sorted(residue_frame_counts.items(), key=lambda x: x[1], reverse=True)

    df = pd.DataFrame({
        "Residue": list(interaction_frequencies.keys()),
        "Frequency (%)": list(interaction_frequencies.values()),
        "Residence Time (%)": [residence_times[res] for res in interaction_frequencies]
    }).sort_values(by="Frequency (%)", ascending=False).reset_index(drop=True)

    summary_txt = "\n🔹 Residue-Ligand Interaction Summary:\n" + df.to_string(index=False)
    summary_txt += "\n\n🔹 Most Frequent RNA Residue Contacts with Ligand (unique frames):\n"
    for res, count in sorted_counts[:20]:
        summary_txt += f"{res}: {count} frames\n"
    print(summary_txt)
    with open(f"{out_prefix}contact_summary.txt", "w") as f:
        f.write(summary_txt)
    df.to_csv(f"{out_prefix}contact_summary.csv", index=False)

    plt.figure(figsize=(12, 4))
    plt.bar([x[0] for x in sorted_counts[:20]], [x[1] for x in sorted_counts[:20]])
    plt.xticks(rotation=90)
    plt.xlabel("RNA Residue")
    plt.ylabel("Unique Frames")
    plt.title("Top 20 Residue-Ligand Contacts (unique frames)")
    plt.tight_layout()
    plt.savefig(f"{out_prefix}contact_barplot.png")
    plt.show()
    print(f"✅ Contact summary (RNA): text, csv, and plot saved (prefix {out_prefix})")

def run_contact_analysis_protein(traj_file, top_file, ligand_resname="UNK", out_prefix="",
                                 ligand_chain_index: Optional[int] = None,
                                 ligand_resSeq: Optional[int] = None,
                                 ligand_atom_indices: Optional[Iterable[int]] = None):
    import mdtraj as md
    import jax.numpy as jnp
    from tqdm import tqdm
    from collections import defaultdict
    import pandas as pd
    import builtins

    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)

    # Protein selection excluding water/ligand
    protein_resnames = set([res.name for res in traj.topology.residues if res.name not in {"HOH", ligand_resname}])
    ligand_atoms = get_ligand_atoms(traj, ligand_resname,
                                    chain_index=ligand_chain_index,
                                    resSeq=ligand_resSeq,
                                    atom_indices=ligand_atom_indices)
    if not ligand_atoms:
        print("❗ No ligand atoms found; protein-contact analysis skipped.")
        return
    protein_atoms = [atom.index for atom in traj.topology.atoms if atom.residue.name.strip() in protein_resnames]

    atom_to_res_obj = {atom.index: atom.residue for atom in traj.topology.atoms if atom.index in protein_atoms}
    atom_to_res_label = {atom.index: f"{atom.residue.name} {atom.residue.resSeq}" for atom in traj.topology.atoms if atom.index in protein_atoms}

    cutoff = 0.4  # nm = 4 Å
    residue_contact_counts = defaultdict(int)
    residue_frame_hits = defaultdict(set)
    residue_unique_labels = defaultdict(set)

    for frame_idx in tqdm(range(coords.shape[0]), desc="Processing frames (protein contact)"):
        lig_xyz = coords[frame_idx, ligand_atoms]
        prot_xyz = coords[frame_idx, protein_atoms]
        diff = lig_xyz[:, None, :] - prot_xyz[None, :, :]
        dists = jnp.linalg.norm(diff, axis=-1)
        contacts = jnp.argwhere(dists < cutoff)
        for _, prot_idx in contacts:
            prot_index = int(protein_atoms[int(prot_idx)])
            res_obj = atom_to_res_obj[prot_index]
            res_label = atom_to_res_label[prot_index]
            residue_contact_counts[res_obj] += 1
            residue_frame_hits[res_obj].add(frame_idx)
            residue_unique_labels[res_label].add(frame_idx)

    if not residue_contact_counts:
        print("ℹ️ No protein contacts detected.")
        return

    total_contacts = builtins.sum(residue_contact_counts.values())
    interaction_frequencies = {
        f"{res}": (count / total_contacts) * 100 for res, count in residue_contact_counts.items()
    }
    residence_times = {
        f"{res}": (len(frames) / traj.n_frames) * 100 for res, frames in residue_frame_hits.items()
    }

    residue_frame_counts = {label: len(frames) for label, frames in residue_unique_labels.items()}
    sorted_counts = sorted(residue_frame_counts.items(), key=lambda x: x[1], reverse=True)

    df = pd.DataFrame({
        "Residue": list(interaction_frequencies.keys()),
        "Frequency (%)": list(interaction_frequencies.values()),
        "Residence Time (%)": [residence_times[res] for res in interaction_frequencies]
    }).sort_values(by="Frequency (%)", ascending=False).reset_index(drop=True)

    summary_txt = "\n🔹 Protein Residue-Ligand Interaction Summary:\n" + df.to_string(index=False)
    summary_txt += "\n\n🔹 Most Frequent Protein Residue Contacts with Ligand (unique frames):\n"
    for res, count in sorted_counts[:20]:
        summary_txt += f"{res}: {count} frames\n"
    print(summary_txt)
    with open(f"{out_prefix}protein_contact_summary.txt", "w") as f:
        f.write(summary_txt)
    df.to_csv(f"{out_prefix}protein_contact_summary.csv", index=False)

    plt.figure(figsize=(12, 4))
    plt.bar([x[0] for x in sorted_counts[:20]], [x[1] for x in sorted_counts[:20]])
    plt.xticks(rotation=90)
    plt.xlabel("Protein Residue")
    plt.ylabel("Unique Frames")
    plt.title("Top 20 Protein Residue-Ligand Contacts (unique frames)")
    plt.tight_layout()
    plt.savefig(f"{out_prefix}protein_contact_barplot.png")
    plt.show()
    print(f"✅ Protein contact summary: text, csv, and plot saved (prefix {out_prefix})")

def wrap_multi_contact_analysis(traj_file, top_file, registry, out_prefix=""):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_contact_analysis_rna(traj_file, top_file,
                                 ligand_resname=e.resname,
                                 out_prefix=pfx,
                                 ligand_chain_index=e.chain_index,
                                 ligand_resSeq=e.resSeq,
                                 ligand_atom_indices=e.atom_indices)
        run_contact_analysis_protein(traj_file, top_file,
                                     ligand_resname=e.resname,
                                     out_prefix=pfx,
                                     ligand_chain_index=e.chain_index,
                                     ligand_resSeq=e.resSeq,
                                     ligand_atom_indices=e.atom_indices)

# -------------------------------------------------
# 6. H‑Bond Analysis (RNA / Protein) – multi‑ligand aware + bug fix
# -------------------------------------------------
def run_hbond_analysis_rna(traj_file, top_file, ligand_resname="UNK", out_prefix="",
                           dist_cutoff=0.35, angle_cutoff=120.0,
                           ligand_chain_index: Optional[int] = None,
                           ligand_resSeq: Optional[int] = None,
                           ligand_atom_indices: Optional[Iterable[int]] = None):
    import mdtraj as md, jax.numpy as jnp
    from tqdm import tqdm
    from collections import defaultdict, Counter
    import pandas as pd, seaborn as sns, matplotlib.pyplot as plt, numpy as np

    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    atoms = list(traj.topology.atoms)

    # --- ligand instance selection ---
    ligand_atoms_list = get_ligand_atoms(traj, ligand_resname,
                                         chain_index=ligand_chain_index,
                                         resSeq=ligand_resSeq,
                                         atom_indices=ligand_atom_indices)
    if not ligand_atoms_list:
        print("❗ No ligand atoms found for H-bond analysis (RNA).")
        return
    is_ligand = np.zeros(len(atoms), dtype=bool)
    is_ligand[np.array(ligand_atoms_list, dtype=int)] = True

    # --- bond map ---
    bond_map = {i: [] for i in range(len(atoms))}
    for a, b in traj.topology.bonds:
        bond_map[a.index].append(b.index)
        bond_map[b.index].append(a.index)

    # --- selection flags ---
    is_water  = np.array([a.residue.name.strip() == "HOH" for a in atoms])
    is_rna    = np.array([a.residue.is_nucleic for a in atoms])  # mdtraj nucleic flag

    # Acceptors: N or O on RNA OR ligand (not water)
    acceptors = np.array([i for i,a in enumerate(atoms)
                          if a.element.symbol in ("N","O") and (is_rna[i] or is_ligand[i]) and not is_water[i]], dtype=int)

    # Donor heavy atoms: N–H, O–H, S–H on RNA OR ligand (not water)
    donors, hydrogens = [], []
    for i, a in enumerate(atoms):
        if is_water[i]:
            continue
        if not (is_rna[i] or is_ligand[i]):
            continue
        if a.element.symbol not in ("N","O","S"):
            continue
        Hs = [h for h in bond_map[i] if atoms[h].element.symbol == "H"]
        if Hs:
            donors.extend([i]*len(Hs))
            hydrogens.extend(Hs)
    donors = np.array(donors, dtype=int)
    hydrogens = np.array(hydrogens, dtype=int)

    if len(donors) == 0 or len(acceptors) == 0:
        print("❗ No donors/acceptors detected after selection.")
        return

    # donor–H vs acceptor triplets (exclude self-acceptor)
    triplets = np.array([(d,h,a) for d,h in zip(donors, hydrogens) for a in acceptors if a != d], dtype=np.int32)
    donor_idxs    = jnp.array(triplets[:,0]); hydrogen_idxs = jnp.array(triplets[:,1]); acceptor_idxs = jnp.array(triplets[:,2])

    ligand_atom_indices_j = jnp.array(ligand_atoms_list, dtype=jnp.int32)
    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices_j) | jnp.isin(acceptor_idxs, ligand_atom_indices_j)

    # --- scan frames ---
    h_bonds_found = []
    n_frames = coords.shape[0]
    for frame_idx in tqdm(range(n_frames), desc="Scanning H-bonds (RNA)"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                                  f"{a.residue.name} {a.residue.resSeq} ({a.name})"))

    with open(f"{out_prefix}hbond_summary.txt", "w") as f:
        for donor, acceptor in h_bonds_found:
            f.write(f"{donor} → {acceptor}\n")
    print(f"✅ H-bond summary saved as {out_prefix}hbond_summary.txt")

    # --- Top residues ---
    residue_counter = Counter()
    for donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand_resname):
                continue
            res_label = entry.split('(')[0].strip()
            residue_counter[res_label] += 1
    if residue_counter:
        df = pd.DataFrame(residue_counter.items(), columns=["Residue", "Count"]).sort_values("Count", ascending=False).reset_index(drop=True)
        plt.figure(figsize=(12, 6)); plt.bar(df["Residue"][:20], df["Count"][:20], color='skyblue')
        plt.title(f"Top 20 Residues Involved in H-Bonds with {ligand_resname}", fontsize=14)
        plt.xlabel("RNA Residue"); plt.ylabel("H-Bond Count"); plt.xticks(rotation=45, ha='right'); plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.6); plt.savefig(f"{out_prefix}hbond_top20_bar.png"); plt.show()

    # --- roles (ligand donor vs acceptor) ---
    donor_roles = Counter(); acceptor_roles = Counter()
    for donor, acceptor in h_bonds_found:
        if donor.startswith(ligand_resname):
            res = acceptor.split('(')[0].strip()
            donor_roles[res] += 1
        elif acceptor.startswith(ligand_resname):
            res = donor.split('(')[0].strip()
            acceptor_roles[res] += 1
    residues = list(set(donor_roles) | set(acceptor_roles))
    if residues:
        df_roles = pd.DataFrame({
            "Residue": residues,
            f"{ligand_resname} as Donor":   [donor_roles.get(r, 0) for r in residues],
            f"{ligand_resname} as Acceptor":[acceptor_roles.get(r, 0) for r in residues]
        }).sort_values([f"{ligand_resname} as Donor", f"{ligand_resname} as Acceptor"], ascending=False).head(20)
        df_roles.set_index("Residue").plot(kind="bar", stacked=True, figsize=(12, 6), colormap="viridis")
        plt.title(f"Top 20 H-Bond Partners ({ligand_resname} as Donor vs Acceptor)", fontsize=14)
        plt.ylabel("Bond Count"); plt.xlabel("RNA Residue"); plt.xticks(rotation=45, ha='right'); plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.5); plt.savefig(f"{out_prefix}hbond_roles_top20_stacked.png"); plt.show()

    # --- per-frame heatmap ---
    framewise_counts = defaultdict(lambda: defaultdict(int))
    for frame_idx in tqdm(range(n_frames), desc="Building frame-wise heatmap"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]; a = atoms[int(acceptor_idxs[idx])]
            for atom in (d, a):
                if atom.residue.name.strip() == ligand_resname:
                    continue
                res_key = f"{atom.residue.name} {atom.residue.resSeq}"
                framewise_counts[frame_idx][res_key] += 1

    if framewise_counts:
        total_counts = defaultdict(int)
        for frame_dict in framewise_counts.values():
            for res, count in frame_dict.items():
                total_counts[res] += count
        top_residues = sorted(total_counts, key=total_counts.get, reverse=True)[:20]
        heatmap_df = pd.DataFrame(index=range(n_frames), columns=top_residues).fillna(0)
        for frame_idx, res_counts in framewise_counts.items():
            for res in top_residues:
                if res in res_counts:
                    heatmap_df.at[frame_idx, res] = res_counts[res]
        plt.figure(figsize=(14, 6)); sns.heatmap(heatmap_df.T, cmap="YlGnBu", cbar_kws={'label': 'H-Bond Count'})
        plt.title("H-Bond Time Series per Residue (Top 20)"); plt.xlabel("Frame"); plt.ylabel("RNA Residue")
        plt.tight_layout(); plt.savefig(f"{out_prefix}hbond_heatmap.png"); plt.show()

    print(f"✅ H-bond summary (txt), top-20 bar, roles, and heatmap saved (prefix {out_prefix})")

def run_hbond_analysis_protein(traj_file, top_file, ligand_resname="UNK", out_prefix="",
                               dist_cutoff=0.35, angle_cutoff=120.0,
                               ligand_chain_index: Optional[int] = None,
                               ligand_resSeq: Optional[int] = None,
                               ligand_atom_indices: Optional[Iterable[int]] = None):
    import mdtraj as md, jax.numpy as jnp
    from collections import defaultdict, Counter
    import pandas as pd, numpy as np, seaborn as sns, matplotlib.pyplot as plt
    from tqdm import tqdm

    traj = md.load_dcd(traj_file, top=top_file)
    atoms = list(traj.topology.atoms)
    coords = jnp.array(traj.xyz)

    # --- ligand instance selection ---
    ligand_atoms_list = get_ligand_atoms(traj, ligand_resname,
                                         chain_index=ligand_chain_index,
                                         resSeq=ligand_resSeq,
                                         atom_indices=ligand_atom_indices)
    if not ligand_atoms_list:
        print("❗ No ligand atoms found for H-bond analysis (protein).")
        return
    is_ligand = np.zeros(len(atoms), dtype=bool)
    is_ligand[np.array(ligand_atoms_list, dtype=int)] = True

    # --- bond map ---
    bond_map = {i: [] for i in range(len(atoms))}
    for a, b in traj.topology.bonds:
        bond_map[a.index].append(b.index)
        bond_map[b.index].append(a.index)

    # --- sets for selection ---
    prot_resnames = {res.name for res in traj.topology.residues if res.name not in {"HOH", ligand_resname}}
    is_protein = np.array([a.residue.name.strip() in prot_resnames for a in atoms])

    # Acceptors: N or O on protein **or ligand**
    acceptors = np.array([i for i,a in enumerate(atoms)
                          if a.element.symbol in ("N","O") and (is_protein[i] or is_ligand[i])], dtype=int)

    # Donors: heavy atoms (N/O/S) with bonded H, on protein OR ligand
    donors, hydrogens = [], []
    for i, a in enumerate(atoms):
        if not (is_protein[i] or is_ligand[i]):
            continue
        if a.element.symbol not in ("N", "O", "S"):
            continue
        Hs = [h for h in bond_map[i] if atoms[h].element.symbol == "H"]
        if Hs:
            donors.extend([i]*len(Hs))
            hydrogens.extend(Hs)
    donors = np.array(donors, dtype=int)
    hydrogens = np.array(hydrogens, dtype=int)

    if len(donors) == 0 or len(acceptors) == 0:
        print("❗ No donors/acceptors detected after selection.")
        return

    triplets = []
    for d, h in zip(donors, hydrogens):
        for a in acceptors:
            if a != d:
                triplets.append((d,h,a))
    triplets = np.array(triplets, dtype=np.int32)

    donor_idxs    = jnp.array(triplets[:,0])
    hydrogen_idxs = jnp.array(triplets[:,1])
    acceptor_idxs = jnp.array(triplets[:,2])

    ligand_atom_indices_j = jnp.array(ligand_atoms_list, dtype=jnp.int32)
    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices_j) | jnp.isin(acceptor_idxs, ligand_atom_indices_j)

    # --- evaluate frames ---
    h_bonds_found = []
    n_frames = coords.shape[0]
    for f in tqdm(range(n_frames), desc="Scanning H-bonds (protein)"):
        xyz = coords[f]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz
        dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        cos_angle = jnp.sum(norm_DH * norm_HA, axis=1)
        angles = jnp.degrees(jnp.arccos(jnp.clip(cos_angle, -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((f,
                f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                f"{a.residue.name} {a.residue.resSeq} ({a.name})"))

    with open(f"{out_prefix}protein_hbond_summary.txt", "w") as f:
        for frame, donor, acceptor in h_bonds_found:
            f.write(f"[frame {frame}] {donor} → {acceptor}\n")
    print(f"✅ Protein H-bond summary saved as {out_prefix}protein_hbond_summary.txt")

    residue_counter = Counter()
    for _, donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand_resname): continue
            res_label = entry.split('(')[0].strip()
            residue_counter[res_label] += 1
    if residue_counter:
        df = pd.DataFrame(residue_counter.items(), columns=["Residue", "Count"]).sort_values("Count", ascending=False).reset_index(drop=True)
        plt.figure(figsize=(12, 6))
        plt.bar(df["Residue"][:20], df["Count"][:20], color='orange')
        plt.title("Top 20 Protein Residues Involved in H-Bonds with Ligand", fontsize=14)
        plt.xlabel("Protein Residue")
        plt.ylabel("H-Bond Count")
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.6)
        plt.savefig(f"{out_prefix}protein_hbond_top20_bar.png")
        plt.show()

    donor_roles = Counter()
    acceptor_roles = Counter()
    for _, donor, acceptor in h_bonds_found:
        lig = ligand_resname.strip().upper()
        if donor.upper().startswith(lig):
            res = acceptor.split('(')[0].strip()
            donor_roles[res] += 1
        elif acceptor.upper().startswith(lig):
            res = donor.split('(')[0].strip()
            acceptor_roles[res] += 1
    residues = list(set(donor_roles) | set(acceptor_roles))
    if residues:
        df_roles = pd.DataFrame({
            "Residue": residues,
            "Ligand as Donor": [donor_roles.get(r, 0) for r in residues],
            "Ligand as Acceptor": [acceptor_roles.get(r, 0) for r in residues]
        }).sort_values(["Ligand as Donor", "Ligand as Acceptor"], ascending=False).head(20)
        df_roles.set_index("Residue").plot(kind="bar", stacked=True, figsize=(12, 6), colormap="magma")
        plt.title("Top 20 H-Bond Partners (Ligand as Donor vs Acceptor)", fontsize=14)
        plt.ylabel("Bond Count")
        plt.xlabel("Protein Residue")
        plt.xticks(rotation=45, ha='right')
        plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.5)
        plt.savefig(f"{out_prefix}protein_hbond_roles_top20_stacked.png")
        plt.show()

    # Per-frame heatmap (top 20)
    framewise_counts = defaultdict(lambda: defaultdict(int))
    for frame_idx in tqdm(range(n_frames), desc="Building protein H-bond heatmap"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz
        dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        cos_angle = jnp.sum(norm_DH * norm_HA, axis=1)
        angles = jnp.degrees(jnp.arccos(jnp.clip(cos_angle, -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            for atom in [d, a]:
                if atom.residue.name.strip() == ligand_resname:
                    continue
                res_key = f"{atom.residue.name} {atom.residue.resSeq}"
                framewise_counts[frame_idx][res_key] += 1

    if framewise_counts:
        total_counts = defaultdict(int)
        for frame_dict in framewise_counts.values():
            for res, count in frame_dict.items():
                total_counts[res] += count
        top_residues = sorted(total_counts, key=total_counts.get, reverse=True)[:20]
        heatmap_df = pd.DataFrame(index=range(n_frames), columns=top_residues).fillna(0)
        for frame_idx, res_counts in framewise_counts.items():
            for res in top_residues:
                if res in res_counts:
                    heatmap_df.at[frame_idx, res] = res_counts[res]
        plt.figure(figsize=(14, 6))
        sns.heatmap(heatmap_df.T, cmap="YlOrBr", cbar_kws={'label': 'H-Bond Count'})
        plt.title("Protein H-Bond Time Series per Residue (Top 20)")
        plt.xlabel("Frame")
        plt.ylabel("Protein Residue")
        plt.tight_layout()
        plt.savefig(f"{out_prefix}protein_hbond_heatmap.png")
        plt.show()

    print(f"✅ Protein H-bond summary (txt), top-20 bar, role stacked, and per-frame heatmap plots saved (prefix {out_prefix})")

def wrap_multi_hbond(traj_file, top_file, registry, out_prefix="", dist_cutoff=0.35, angle_cutoff=120.0):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_hbond_analysis_rna(traj_file, top_file,
                               ligand_resname=e.resname, out_prefix=pfx,
                               dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff,
                               ligand_chain_index=e.chain_index, ligand_resSeq=e.resSeq,
                               ligand_atom_indices=e.atom_indices)
        run_hbond_analysis_protein(traj_file, top_file,
                                   ligand_resname=e.resname, out_prefix=pfx,
                                   dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff,
                                   ligand_chain_index=e.chain_index, ligand_resSeq=e.resSeq,
                                   ligand_atom_indices=e.atom_indices)

# -------------------------------------------------
# 7. PCA & FEL (Overlay) – unchanged (not ligand-specific)
# -------------------------------------------------
def run_pca_fel_overlay(traj_apo_file, top_apo_file, traj_holo_file, top_holo_file, out_prefix=""):
    import mdtraj as md, numpy as np
    import matplotlib.pyplot as plt
    from sklearn.decomposition import PCA
    from scipy.constants import Boltzmann

    # --- load
    traj_apo  = md.load(traj_apo_file,  top=top_apo_file)
    traj_holo = md.load(traj_holo_file, top=top_holo_file)

    # --- try RNA selection (phosphorus)
    sel_apo  = traj_apo.top.select("nucleic and name P")
    sel_holo = traj_holo.top.select("nucleic and name P")

    def select_CA_intersection(t):
        """Return Cα indices mapped by (chain.id, resSeq) for a protein."""
        ca_map = {}
        for a in t.top.atoms:
            if a.name.strip() == "CA" and a.residue.is_protein:
                key = (getattr(a.residue.chain, "id", ""), a.residue.resSeq)
                ca_map[key] = a.index
        return ca_map

    # --- if no P atoms in either, fall back to protein CA matched by (chain,resSeq)
    if len(sel_apo) == 0 or len(sel_holo) == 0:
        ca_apo  = select_CA_intersection(traj_apo)
        ca_holo = select_CA_intersection(traj_holo)
        common_keys = sorted(set(ca_apo) & set(ca_holo))
        sel_apo  = np.array([ca_apo[k]  for k in common_keys], dtype=int)
        sel_holo = np.array([ca_holo[k] for k in common_keys], dtype=int)

    # --- final sanity
    if sel_apo.size == 0 or sel_holo.size == 0:
        raise ValueError("No atoms selected for PCA (neither RNA P nor protein CA found in common).")
    if sel_apo.size != sel_holo.size:
        raise ValueError(f"Selection mismatch: apo={sel_apo.size}, holo={sel_holo.size} — ensure both trajectories cover the same residues.")

    # --- slice & align
    traj_apo_s  = traj_apo.atom_slice(sel_apo)
    traj_holo_s = traj_holo.atom_slice(sel_holo)
    traj_apo_s.superpose(traj_apo_s, 0)
    traj_holo_s.superpose(traj_apo_s, 0)

    # --- flatten for PCA
    xyz_apo  = traj_apo_s.xyz.reshape(traj_apo_s.n_frames, -1)
    xyz_holo = traj_holo_s.xyz.reshape(traj_holo_s.n_frames, -1)

    if xyz_apo.shape[1] == 0 or not np.all(np.isfinite(xyz_apo)):
        raise ValueError("Apo feature matrix is empty or non-finite.")
    if xyz_holo.shape[1] == 0 or not np.all(np.isfinite(xyz_holo)):
        raise ValueError("Holo feature matrix is empty or non-finite.")

    # --- PCA
    pca = PCA(n_components=2)
    pca.fit(xyz_apo)
    pc_apo  = pca.transform(xyz_apo)
    pc_holo = pca.transform(xyz_holo)

    # --- plot PCA
    plt.figure(figsize=(8,5))
    plt.scatter(pc_apo[:,0],  pc_apo[:,1],  alpha=0.5, label="Apo",  color="blue")
    plt.scatter(pc_holo[:,0], pc_holo[:,1], alpha=0.5, label="Holo", color="red")
    plt.xlabel(f"PC1 ({pca.explained_variance_ratio_[0]*100:.2f}% var)")
    plt.ylabel(f"PC2 ({pca.explained_variance_ratio_[1]*100:.2f}% var)")
    plt.title("PCA Projection: Apo vs Ligand-bound")
    plt.legend(); plt.grid(True); plt.tight_layout()
    plt.savefig(f"{out_prefix}pca_overlay.png")
    print(f"✅ PCA overlay saved as {out_prefix}pca_overlay.png")

    # --- FEL helper
    def compute_fel(pc1, pc2, bins=100):
        H, xedges, yedges = np.histogram2d(pc1, pc2, bins=bins, density=True)
        P = H.T; P[P==0] = 1e-12
        G = -Boltzmann * 310.15 * np.log(P); G -= G.min()
        return G, xedges, yedges

    G_apo, x_a, y_a   = compute_fel(pc_apo[:,0],  pc_apo[:,1])
    G_holo, x_h, y_h  = compute_fel(pc_holo[:,0], pc_holo[:,1])
    X_a, Y_a = np.meshgrid(x_a[:-1], y_a[:-1])
    X_h, Y_h = np.meshgrid(x_h[:-1], y_h[:-1])

    plt.figure(figsize=(12,5))
    plt.subplot(1,2,1); cp1 = plt.contourf(X_a, Y_a, G_apo, levels=30, cmap="Blues")
    plt.colorbar(cp1, label="Free Energy (J)"); plt.title("FEL: Apo");  plt.xlabel("PC1"); plt.ylabel("PC2")
    plt.subplot(1,2,2); cp2 = plt.contourf(X_h, Y_h, G_holo, levels=30, cmap="Reds")
    plt.colorbar(cp2, label="Free Energy (J)"); plt.title("FEL: Holo"); plt.xlabel("PC1"); plt.ylabel("PC2")
    plt.tight_layout(); plt.savefig(f"{out_prefix}fel_overlay.png")
    print(f"✅ FEL overlay saved as {out_prefix}fel_overlay.png")

# -------------------------------------------------
# 8. WC pair checker (Overlay) – unchanged (not ligand-specific)
# -------------------------------------------------
def run_wc_pair_checker_overlay(
    traj_apo_file, top_apo_file, traj_holo_file, top_holo_file, out_prefix=""
):
    import mdtraj as md
    import jax.numpy as jnp
    from tqdm import tqdm
    import matplotlib.pyplot as plt

    def get_pairs(traj, coords):
        topology = traj.topology
        atoms = list(topology.atoms)
        wc_pairs = {
            ("A", "U"): ("N1", "N3"),
            ("U", "A"): ("N3", "N1"),
            ("G", "C"): ("N1", "N3"),
            ("C", "G"): ("N3", "N1"),
        }
        min_seq_gap = 4
        atom_lookup = {
            (atom.residue.name.strip(), atom.residue.resSeq, atom.name): atom.index
            for atom in atoms
        }
        rna_residues = [
            res
            for res in topology.residues
            if res.name.strip() in {"A", "U", "G", "C"}
        ]
        pairs = []
        for i, res1 in enumerate(rna_residues):
            for j in range(i + 1, len(rna_residues)):
                res2 = rna_residues[j]
                if abs(res1.resSeq - res2.resSeq) < min_seq_gap:
                    continue
                pair_key = (res1.name.strip(), res2.name.strip())
                if pair_key not in wc_pairs:
                    continue
                atom1_name, atom2_name = wc_pairs[pair_key]
                idx1 = atom_lookup.get((res1.name.strip(), res1.resSeq, atom1_name))
                idx2 = atom_lookup.get((res2.name.strip(), res2.resSeq, atom2_name))
                if idx1 is None or idx2 is None:
                    continue
                dist = jnp.linalg.norm(coords[0, idx1] - coords[0, idx2])
                if dist < 0.35:
                    pairs.append((res1, idx1, res2, idx2))
        return pairs

    def pair_status_over_time(coords, pairs):
        framewise_status = []
        for frame in range(coords.shape[0]):
            count = 0
            for res1, idx1, res2, idx2 in pairs:
                dist = jnp.linalg.norm(coords[frame, idx1] - coords[frame, idx2])
                if dist < 0.35:
                    count += 1
            framewise_status.append(count)
        return framewise_status

    # Apo trajectory
    traj_apo = md.load_dcd(traj_apo_file, top=top_apo_file)
    coords_apo = jnp.array(traj_apo.xyz)
    pairs_apo = get_pairs(traj_apo, coords_apo)
    print(f"✅ [Apo] Detected {len(pairs_apo)} WC pairs in frame 0")
    wc_apo = pair_status_over_time(coords_apo, pairs_apo)

    # Holo trajectory
    traj_holo = md.load_dcd(traj_holo_file, top=top_holo_file)
    coords_holo = jnp.array(traj_holo.xyz)
    pairs_holo = get_pairs(traj_holo, coords_holo)
    print(f"✅ [Ligand] Detected {len(pairs_holo)} WC pairs in frame 0")
    wc_holo = pair_status_over_time(coords_holo, pairs_holo)

    # Plot
    plt.figure(figsize=(10, 4))
    plt.plot(wc_apo, label="Apo (No Ligand)", color="blue")
    plt.plot(wc_holo, label="Ligand-bound", color="red")
    plt.xlabel("Frame")
    plt.ylabel("Intact Watson–Crick Pairs")
    plt.title("WC Base Pair Stability Over Time")
    plt.grid()
    plt.legend()
    plt.tight_layout()
    fname = f"{out_prefix}wc_pair_stability_overlay.png"
    plt.savefig(fname)
    plt.show()
    print(f"📊 Overlay plot saved as {fname}")

# -------------------------------------------------
# 9. Ligand–RNA Atom Contact Frequencies – multi‑ligand aware
# -------------------------------------------------
def run_ligand_rna_atom_contact_frequencies_safe(
    traj_file="production_md.dcd",
    top_file="final_structure.pdb",
    ligand_resname="UNK",
    out_prefix="",
    ligand_chain_index: Optional[int] = None,
    ligand_resSeq: Optional[int] = None,
    ligand_atom_indices: Optional[Iterable[int]] = None
):
    """
    Computes H-bonds between the chosen ligand instance and RNA, then tabulates RNA atom contacts.
    """
    import mdtraj as md
    import jax.numpy as jnp
    import numpy as np
    import pandas as pd
    from collections import defaultdict
    import re
    from IPython.display import display
    from tqdm import tqdm

    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    atoms = list(traj.topology.atoms)

    # Ligand instance
    ligand_atoms_list = get_ligand_atoms(traj, ligand_resname,
                                         chain_index=ligand_chain_index,
                                         resSeq=ligand_resSeq,
                                         atom_indices=ligand_atom_indices)
    if not ligand_atoms_list:
        print("❗ No ligand atoms found; skipping ligand–RNA atom frequency.")
        return
    ligand_atom_indices_j = jnp.array(ligand_atoms_list, dtype=jnp.int32)

    # Bond map
    bond_map = {i: [] for i in range(len(atoms))}
    for bond in traj.topology.bonds:
        bond_map[bond[0].index].append(bond[1].index)
        bond_map[bond[1].index].append(bond[0].index)

    # Only RNA and ligand as donors/acceptors (no water)
    rna_bases = {"A", "U", "G", "C"}
    acceptors = [a for a in atoms if a.element.symbol in ['N', 'O'] and a.residue.name.strip() in rna_bases]
    acceptor_indices_set = set(a.index for a in acceptors)
    triplets_np = []
    for h in atoms:
        if h.element.symbol != 'H':
            continue
        if h.residue.name.strip() not in (rna_bases | {ligand_resname}):
            continue
        bonded = bond_map[h.index]
        if not bonded:
            continue
        d_idx = bonded[0]
        for a_idx in acceptor_indices_set:
            if a_idx != d_idx:
                triplets_np.append((d_idx, h.index, a_idx))
    if len(triplets_np) == 0:
        print("ℹ️ No candidate donor–H–acceptor triplets.")
        return
    triplets_np = np.array(triplets_np, dtype=np.int32)
    triplets = jnp.array(triplets_np)
    donor_idxs = triplets[:, 0]
    hydrogen_idxs = triplets[:, 1]
    acceptor_idxs = triplets[:, 2]

    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices_j) | jnp.isin(acceptor_idxs, ligand_atom_indices_j)

    # Find contacts as H-bonds and tally RNA atoms
    h_bonds_found = []
    dist_cutoff = 0.35  # nm
    angle_cutoff = 120.0  # degrees
    n_frames = coords.shape[0]
    for frame_idx in tqdm(range(n_frames), desc="Scanning ligand–RNA H-bonds"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]
        h_xyz = xyz[hydrogen_idxs]
        a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz
        dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        cos_angle = jnp.sum(norm_DH * norm_HA, axis=1)
        angles = jnp.degrees(jnp.arccos(jnp.clip(cos_angle, -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((
                f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                f"{a.residue.name} {a.residue.resSeq} ({a.name})"
            ))

    if not h_bonds_found:
        print("❗ No ligand–RNA H-bonds found. Nothing to tabulate.")
        return

    atom_contact_counts = defaultdict(int)
    for donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand_resname):
                continue
            match = re.match(r"([AUGC])\s\d+\s\((\w+)\)", entry)
            if match:
                base, atom = match.groups()
                key = f"{base}-{atom}"
                atom_contact_counts[key] += 1

    df = pd.DataFrame(atom_contact_counts.items(), columns=["RNA Atom", "Contact Count"])
    df = df.sort_values(by="Contact Count", ascending=False).reset_index(drop=True)

    print("🔹 Most Frequently Contacted RNA Atoms by ligand:")
    try:
        from IPython.display import display as _display
        _display(df.head(30))
    except Exception:
        print(df.head(30).to_string(index=False))

    df.to_csv(f"{out_prefix}ligand_rna_atom_contact_frequencies.csv", index=False)
    print(f"✅ Saved to '{out_prefix}ligand_rna_atom_contact_frequencies.csv'")

def wrap_multi_ligand_rna_atom_contacts(traj_file, top_file, registry, out_prefix=""):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_ligand_rna_atom_contact_frequencies_safe(
            traj_file=traj_file, top_file=top_file,
            ligand_resname=e.resname, out_prefix=pfx,
            ligand_chain_index=e.chain_index, ligand_resSeq=e.resSeq, ligand_atom_indices=e.atom_indices
        )

# -------------------------------------------------
# 10. Carboxylate - OP1/2 P binding checker – multi‑ligand aware
# -------------------------------------------------
def run_carboxylate_OP_checker(
    traj_file, top_file, ligand_resname="UNK", out_prefix="carboxylate_OP_",
    ligand_chain_index: Optional[int] = None,
    ligand_resSeq: Optional[int] = None,
    ligand_atom_indices: Optional[Iterable[int]] = None
):
    """
    Checks and visualizes ligand carboxylate O contacts with RNA OP1/OP2.
    Saves heatmap, barplot, and prints top contacts.
    """
    import mdtraj as md
    import jax.numpy as jnp
    import numpy as np
    import matplotlib.pyplot as plt
    import seaborn as sns
    from tqdm import tqdm

    traj = md.load_dcd(traj_file, top=top_file)
    atoms = list(traj.topology.atoms)

    # Ligand instance (restrict selection to this ligand only)
    ligand_atoms_list = get_ligand_atoms(traj, ligand_resname,
                                         chain_index=ligand_chain_index,
                                         resSeq=ligand_resSeq,
                                         atom_indices=ligand_atom_indices)
    if not ligand_atoms_list:
        print("❗ No ligand atoms found; carboxylate check aborted.")
        return
    ligand_atoms_set = set(ligand_atoms_list)

    # 1. Find ligand carboxylate O atoms (from THIS ligand instance only)
    carboxylate_O_names = {"O", "OXT", "O1", "O2"}
    ligand_O_idxs = [
        atom.index for atom in atoms
        if (atom.index in ligand_atoms_set) and (atom.element.symbol == "O" or atom.name.strip() in carboxylate_O_names)
    ]
    if not ligand_O_idxs:
        print("❗ No carboxylate/oxygen atoms found in the ligand instance. Analysis aborted.")
        return

    print(f"Found ligand oxygen atoms (indices): {ligand_O_idxs}")

    # 2. Find all RNA OP1/OP2 atoms
    rna_bases = {"A", "U", "G", "C"}
    phos_names = {"OP1", "OP2"}
    rna_OP_idxs = []
    rna_OP_labels = []
    for atom in atoms:
        if atom.residue.name.strip() in rna_bases and atom.name.strip() in phos_names:
            rna_OP_idxs.append(atom.index)
            rna_OP_labels.append(f"{atom.residue.name.strip()}{atom.residue.resSeq}-{atom.name.strip()}")
    print(f"Found {len(rna_OP_idxs)} OP1/OP2 atoms in RNA backbone.")

    # 3. Extract coordinates
    coords = jnp.array(traj.xyz)
    ligand_coords = coords[:, ligand_O_idxs, :]
    rna_OP_coords = coords[:, rna_OP_idxs, :]
    n_frames = coords.shape[0]
    n_OP = len(rna_OP_idxs)
    n_ligand_O = len(ligand_O_idxs)

    # 4. Compute contacts
    threshold = 0.35  # nm
    contact_matrix = np.zeros((n_frames, n_OP), dtype=int)
    print("Computing contacts (ligand O ↔ OP1/OP2)...")
    for f in tqdm(range(n_frames)):
        for li in range(n_ligand_O):
            dists = jnp.linalg.norm(rna_OP_coords[f] - ligand_coords[f, li], axis=1)
            contact_matrix[f] = np.logical_or(contact_matrix[f], np.array(dists < threshold))

    # 5. Occupancy per OP
    occupancy = contact_matrix.sum(axis=0) / n_frames

    # 6. Save data
    np.save(out_prefix + "contact_matrix.npy", contact_matrix)
    np.save(out_prefix + "occupancy.npy", occupancy)
    with open(out_prefix + "labels.txt", "w") as f:
        for label in rna_OP_labels:
            f.write(label + "\n")

    # 7. Plots
    plt.figure(figsize=(14, 3))
    sns.heatmap(contact_matrix.T, cmap="Blues", cbar=True, yticklabels=rna_OP_labels)
    plt.title("Ligand O – RNA OP1/OP2 Contacts (framewise)")
    plt.xlabel("Frame")
    plt.ylabel("RNA OP1/OP2 Atom")
    plt.tight_layout()
    plt.savefig(out_prefix + "contact_heatmap.png", dpi=200)
    plt.show()

    plt.figure(figsize=(16, 4))
    sns.barplot(x=rna_OP_labels, y=occupancy)
    plt.xticks(rotation=90)
    plt.ylabel("Contact Occupancy (fraction)")
    plt.title("Occupancy of Ligand O Contact with RNA OP1/OP2")
    plt.tight_layout()
    plt.savefig(out_prefix + "occupancy.png", dpi=200)
    plt.show()

    print(f"Saved: {out_prefix}contact_heatmap.png and {out_prefix}occupancy.png")

    # 8. Top 10 contacts
    op_contact = list(zip(rna_OP_labels, occupancy))
    op_contact_sorted = sorted(op_contact, key=lambda x: x[1], reverse=True)
    print("\nTop 10 ligand–OP contacts by occupancy:")
    for label, occ in op_contact_sorted[:10]:
        print(f'{label}: {occ:.3f}')

    print(f"✅ Carboxylate–OP checker complete! (prefix '{out_prefix}')")

def wrap_multi_carboxylate_OP_checker(traj_file, top_file, registry, out_prefix="carboxylate_OP_"):
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        run_carboxylate_OP_checker(traj_file, top_file,
                                   ligand_resname=e.resname,
                                   out_prefix=pfx,
                                   ligand_chain_index=e.chain_index,
                                   ligand_resSeq=e.resSeq,
                                   ligand_atom_indices=e.atom_indices)

# -----------------------------
# (Optional) π–π stacking (per-ligand wrapper)
# -----------------------------
def wrap_multi_pi_pi_stacking(traj_file, top_file, ligand_ring_defs, registry, out_prefix="pi_pi_"):
    """
    Calls your existing run_pi_pi_stacking for each ligand instance by restricting
    ligand atom selection inside that function to this ligand’s indices using the
    enhanced get_ligand_atoms (requires that function to call get_ligand_atoms).
    If your current run_pi_pi_stacking already uses get_ligand_atoms by resname,
    please update it similarly to accept chain/resSeq/indices, then this wrapper
    will just forward those params.
    """
    for e in for_each_ligand(registry):
        pfx = f"{out_prefix}{e.label}_"
        # Assuming you update run_pi_pi_stacking signature similarly:
        run_pi_pi_stacking(traj_file, top_file, ligand_ring_defs,
                           ligand_resname=e.resname, out_prefix=pfx)  # If needed, extend signature as above

# ======================== MULTI‑LIGAND INFRASTRUCTURE ========================
from dataclasses import dataclass
import mdtraj as md
import numpy as np
import jax.numpy as jnp
import matplotlib.pyplot as plt
from typing import List, Dict, Iterable, Optional, Tuple
from tqdm import tqdm
import seaborn as sns
import pandas as pd
import builtins

# --- small utils --------------------------------------------------------------
def _chain_id_of(res_or_atom):
    """Return a robust textual chain id for mdtraj residues/atoms."""
    ch = getattr(res_or_atom.residue if hasattr(res_or_atom, "residue") else res_or_atom, "chain", None)
    if ch is None:
        return "?"
    # mdtraj Chain has .id or .index across versions
    cid = getattr(ch, "id", None)
    if cid is None or str(cid).strip() == "":
        return str(getattr(ch, "index", "?"))
    return str(cid)

def _time_ns(traj) -> np.ndarray:
    """Return per-frame time (ns) from an mdtraj trajectory with robust fallbacks."""
    if hasattr(traj, "timestep") and traj.timestep is not None:
        try:
            return np.arange(traj.n_frames) * float(traj.timestep) / 1000.0
        except Exception:
            pass
    if hasattr(traj, "time") and traj.time is not None and len(traj.time) > 0:
        return np.asarray(traj.time, dtype=float) / 1000.0  # ps -> ns
    # fallback: 1 ps stride
    return np.arange(traj.n_frames) * 0.001

# --- datamodel ----------------------------------------------------------------
@dataclass
class LigandRef:
    key: str                # unique label, e.g. "UNK_B1" or "aspirin"
    resname: str            # usually "UNK"
    chain_id: str           # textual chain id
    resSeq: int             # PDB-style residue number
    atom_indices: np.ndarray  # indices of atoms for just this ligand (in the topology)

class LigandRegistry:
    """
    Registry of ligands defined by (resname, chain_id, resSeq) → atom indices.
    Optionally supports pretty display names via alias_map.
    """
    def __init__(
        self,
        top_file: str,
        allowed_resnames: Iterable[str] = ("UNK",),
        alias_map: Optional[Dict[Tuple[str,int,str], str]] = None,
    ):
        alias_map = alias_map or {}
        t = md.load(top_file)
        top = t.topology
        ligs: List[LigandRef] = []
        for res in top.residues:
            rname = res.name.strip()
            if rname not in allowed_resnames:
                continue
            chain_id = _chain_id_of(res)
            resSeq = int(res.resSeq)
            idxs = np.array([a.index for a in res.atoms], dtype=int)
            # key: alias if provided, else UNK_{chain}{resSeq}
            alias = alias_map.get((rname, resSeq, chain_id))
            key = alias if (alias and str(alias).strip()) else f"{rname}_{chain_id}{resSeq}"
            ligs.append(LigandRef(key=key, resname=rname, chain_id=chain_id, resSeq=resSeq, atom_indices=idxs))
        self.ligands: List[LigandRef] = ligs
        # pretty print once
        if self.ligands:
            print("Ligand registry (label → UNK residue mapping):")
            for lg in self.ligands:
                print(f"  - {lg.key:>12}  →  {lg.resname}  chain {lg.chain_id}  resSeq {lg.resSeq}  (atoms: {lg.atom_indices.size})")
        else:
            print("❗ No ligands matched allowed_resnames in the provided topology.")

    def select(self, selection: Optional[Iterable[str]] = None) -> List[LigandRef]:
        """selection: None/'ALL' or iterable of keys to include."""
        if selection is None or (isinstance(selection, str) and selection.upper() == "ALL"):
            return list(self.ligands)
        wanted = set(selection)
        out = [lg for lg in self.ligands if (lg.key in wanted)]
        if not out:
            print("⚠️ selection did not match any registry keys; nothing to do.")
        return out

# Standardized prefix helper
def _prefix_for(base: str, lig: LigandRef) -> str:
    base = base or ""
    if base and (not base.endswith("_")):
        base = base + "_"
    return f"{base}{lig.key}_"

# Build a boolean mask for “this ligand only”
def _is_this_ligand_mask(atoms: List[md.core.topology.Atom], lig: LigandRef) -> np.ndarray:
    mask = np.zeros(len(atoms), dtype=bool)
    for i, a in enumerate(atoms):
        if a.residue.name.strip() == lig.resname and int(a.residue.resSeq) == lig.resSeq and _chain_id_of(a) == lig.chain_id:
            mask[i] = True
    return mask

# ========================= PER‑LIGAND CORE FUNCTIONS ==========================
# Each “core” uses ligand atom indices directly and writes files with the provided prefix.
# Wrappers below iterate over the registry and call these cores per ligand.

# -- Kabsch helpers for RMSD --
def _kabsch_single(P: jnp.ndarray, Q: jnp.ndarray) -> jnp.ndarray:
    """
    Return the rotation matrix R (3x3) that best aligns P->Q by Kabsch.
    P,Q: (n,3) JAX arrays with centroids removed prior to call.
    """
    C = P.T @ Q
    U, S, Vt = jnp.linalg.svd(C, full_matrices=False)
    R = U @ Vt
    det = jnp.linalg.det(R)
    R = jnp.where(det < 0, U @ jnp.diag(jnp.array([1.0, 1.0, -1.0])) @ Vt, R)
    return R

def _rmsd_to_ref(X: jnp.ndarray, Q0: jnp.ndarray) -> jnp.ndarray:
    """
    RMSD per frame after optimal superposition to frame-0 reference.
    X : (F, L, 3) ligand coords
    Q0: (L, 3)    reference (frame 0)
    """
    # center
    Xc = X - jnp.mean(X, axis=1, keepdims=True)
    Qc = Q0 - jnp.mean(Q0, axis=0, keepdims=True)
    def _frame_rmsd(P):
        R = _kabsch_single(P, Qc)
        diff = (P @ R) - Qc
        return jnp.sqrt(jnp.mean(jnp.sum(diff*diff, axis=1)))
    return jnp.array([_frame_rmsd(Xc[f]) for f in range(X.shape[0])])

# 3. Ligand RMSD (JAX, per‑ligand core)
def run_ligand_rmsd_core(traj_file: str, top_file: str, ligand_indices: np.ndarray, out_prefix: str, label: str):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)[:, ligand_indices, :]  # (F, L, 3)
    rmsd = _rmsd_to_ref(coords, coords[0])
    t_ns = _time_ns(traj)
    plt.figure(figsize=(8, 5))
    plt.plot(t_ns, np.asarray(rmsd), label=f"{label} RMSD (nm)")
    plt.xlabel("Time (ns)"); plt.ylabel("RMSD (nm)")
    plt.title(f"Ligand RMSD – {label}"); plt.grid(True); plt.legend(); plt.tight_layout()
    fname = f"{out_prefix}ligand_rmsd.png"; plt.savefig(fname); plt.close()
    print(f"✅ {label}: RMSD plot saved as {fname}")

# 4. Hydration shell (per‑ligand core; JAX distances)
def run_hydration_shell_core(traj_file: str, top_file: str, ligand_indices: np.ndarray,
                             out_prefix: str, label: str, dist_cutoff: float = 0.35):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    water_atoms = np.array(traj.topology.select("water"), dtype=int)
    if water_atoms.size == 0:
        print(f"⚠️ {label}: no waters found; skipping hydration shell.")
        return
    lig_xyz = coords[:, ligand_indices, :]
    wat_xyz = coords[:, water_atoms, :]
    # distances (F, L, W)
    dists = jnp.linalg.norm(lig_xyz[:, :, None, :] - wat_xyz[:, None, :, :], axis=-1)
    min_dists = jnp.min(dists, axis=1)  # (F, W)
    hydration_counts = jnp.sum(min_dists < dist_cutoff, axis=1)
    plt.figure(figsize=(8, 5))
    plt.plot(np.arange(traj.n_frames), np.asarray(hydration_counts), label="Hydration Count")
    plt.xlabel("Frame"); plt.ylabel("# water within cutoff")
    plt.title(f"Hydration Shell Around {label} (cutoff={dist_cutoff:.2f} nm)")
    plt.grid(True); plt.legend(); plt.tight_layout()
    fname = f"{out_prefix}hydration_shell.png"; plt.savefig(fname); plt.close()
    print(f"✅ {label}: hydration shell plot saved as {fname}")

# 5a. Contact Analysis — RNA (per‑ligand core)
def run_contact_analysis_rna_core(traj_file: str, top_file: str, ligand_indices: np.ndarray,
                                  out_prefix: str, label: str, cutoff: float = 0.40):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    rna_base_names = {"A","U","G","C","DA","DG","DT","DC","DU"}
    rna_atoms = [a.index for a in traj.topology.atoms if a.residue.name.strip() in rna_base_names]
    if not rna_atoms:
        print(f"⚠️ {label}: no RNA atoms found; skipping.")
        return

    atom_to_res_obj = {a.index: a.residue for a in traj.topology.atoms if a.index in rna_atoms}
    atom_to_res_label = {a.index: f"{a.residue.name} {a.residue.resSeq}" for a in traj.topology.atoms if a.index in rna_atoms}

    residue_contact_counts = defaultdict(int)
    residue_frame_hits = defaultdict(set)
    residue_unique_labels = defaultdict(set)

    for frame_idx in tqdm(range(coords.shape[0]), desc=f"[{label}] contacts RNA"):
        lig_xyz = coords[frame_idx, ligand_indices]
        rna_xyz = coords[frame_idx, rna_atoms]
        dists = jnp.linalg.norm(lig_xyz[:, None, :] - rna_xyz[None, :, :], axis=-1)
        contacts = jnp.argwhere(dists < cutoff)
        for _, rna_idx in contacts:
            rna_index = int(rna_atoms[int(rna_idx)])
            res_obj = atom_to_res_obj[rna_index]
            res_label = atom_to_res_label[rna_index]
            residue_contact_counts[res_obj] += 1
            residue_frame_hits[res_obj].add(frame_idx)
            residue_unique_labels[res_label].add(frame_idx)

    total_contacts = builtins.sum(residue_contact_counts.values()) or 1
    interaction_frequencies = {f"{res}": (count / total_contacts) * 100 for res, count in residue_contact_counts.items()}
    residence_times = {f"{res}": (len(frames) / traj.n_frames) * 100 for res, frames in residue_frame_hits.items()}

    residue_frame_counts = {label_: len(frames) for label_, frames in residue_unique_labels.items()}
    sorted_counts = sorted(residue_frame_counts.items(), key=lambda x: x[1], reverse=True)

    df = pd.DataFrame({
        "Residue": list(interaction_frequencies.keys()),
        "Frequency (%)": list(interaction_frequencies.values()),
        "Residence Time (%)": [residence_times[res] for res in interaction_frequencies]
    }).sort_values(by="Frequency (%)", ascending=False).reset_index(drop=True)

    summary_txt = f"\n🔹 [{label}] RNA Residue–Ligand Interaction Summary:\n" + df.to_string(index=False)
    summary_txt += "\n\n🔹 Most Frequent RNA Residue Contacts (unique frames):\n"
    for res, count in sorted_counts[:20]:
        summary_txt += f"{res}: {count} frames\n"
    print(summary_txt)
    with open(f"{out_prefix}contact_summary.txt", "w") as f:
        f.write(summary_txt)
    df.to_csv(f"{out_prefix}contact_summary.csv", index=False)

    plt.figure(figsize=(12, 4))
    plt.bar([x[0] for x in sorted_counts[:20]], [x[1] for x in sorted_counts[:20]])
    plt.xticks(rotation=90); plt.xlabel("RNA Residue"); plt.ylabel("Unique Frames")
    plt.title(f"Top 20 RNA Contacts – {label}")
    plt.tight_layout(); plt.savefig(f"{out_prefix}contact_barplot.png"); plt.close()
    print(f"✅ {label}: contact summary saved (txt/csv/plot) with prefix {out_prefix}")

# 5b. Contact Analysis — Protein (per‑ligand core)
def run_contact_analysis_protein_core(traj_file: str, top_file: str, ligand_indices: np.ndarray,
                                      out_prefix: str, label: str, cutoff: float = 0.40):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)

    protein_resnames = set([res.name for res in traj.topology.residues if res.name not in {"HOH","WAT","SOL"}])
    protein_atoms = [a.index for a in traj.topology.atoms if a.residue.name.strip() in protein_resnames and a.residue.is_protein]

    atom_to_res_obj = {a.index: a.residue for a in traj.topology.atoms if a.index in protein_atoms}
    atom_to_res_label = {a.index: f"{a.residue.name} {a.residue.resSeq}" for a in traj.topology.atoms if a.index in protein_atoms}

    residue_contact_counts = defaultdict(int)
    residue_frame_hits = defaultdict(set)
    residue_unique_labels = defaultdict(set)

    for frame_idx in tqdm(range(coords.shape[0]), desc=f"[{label}] contacts PROT"):
        lig_xyz = coords[frame_idx, ligand_indices]
        prot_xyz = coords[frame_idx, protein_atoms]
        dists = jnp.linalg.norm(lig_xyz[:, None, :] - prot_xyz[None, :, :], axis=-1)
        contacts = jnp.argwhere(dists < cutoff)
        for _, prot_idx in contacts:
            prot_index = int(protein_atoms[int(prot_idx)])
            res_obj = atom_to_res_obj[prot_index]
            res_label = atom_to_res_label[prot_index]
            residue_contact_counts[res_obj] += 1
            residue_frame_hits[res_obj].add(frame_idx)
            residue_unique_labels[res_label].add(frame_idx)

    total_contacts = builtins.sum(residue_contact_counts.values()) or 1
    interaction_frequencies = {f"{res}": (count / total_contacts) * 100 for res, count in residue_contact_counts.items()}
    residence_times = {f"{res}": (len(frames) / traj.n_frames) * 100 for res, frames in residue_frame_hits.items()}

    residue_frame_counts = {lab: len(frames) for lab, frames in residue_unique_labels.items()}
    sorted_counts = sorted(residue_frame_counts.items(), key=lambda x: x[1], reverse=True)

    df = pd.DataFrame({
        "Residue": list(interaction_frequencies.keys()),
        "Frequency (%)": list(interaction_frequencies.values()),
        "Residence Time (%)": [residence_times[res] for res in interaction_frequencies]
    }).sort_values(by="Frequency (%)", ascending=False).reset_index(drop=True)

    summary_txt = f"\n🔹 [{label}] Protein Residue–Ligand Interaction Summary:\n" + df.to_string(index=False)
    summary_txt += "\n\n🔹 Most Frequent Protein Residue Contacts (unique frames):\n"
    for res, count in sorted_counts[:20]:
        summary_txt += f"{res}: {count} frames\n"
    print(summary_txt)
    with open(f"{out_prefix}protein_contact_summary.txt", "w") as f:
        f.write(summary_txt)
    df.to_csv(f"{out_prefix}protein_contact_summary.csv", index=False)

    plt.figure(figsize=(12, 4))
    plt.bar([x[0] for x in sorted_counts[:20]], [x[1] for x in sorted_counts[:20]])
    plt.xticks(rotation=90); plt.xlabel("Protein Residue"); plt.ylabel("Unique Frames")
    plt.title(f"Top 20 Protein Contacts – {label}")
    plt.tight_layout(); plt.savefig(f"{out_prefix}protein_contact_barplot.png"); plt.close()
    print(f"✅ {label}: protein contact summary saved (txt/csv/plot) with prefix {out_prefix}")

# 6a. H-Bond Analysis — RNA (per‑ligand core)  [also fixes 'involves_unk_mask' bug]
def run_hbond_analysis_rna_core(traj_file: str, top_file: str, ligand: LigandRef,
                                out_prefix: str, dist_cutoff: float = 0.35, angle_cutoff: float = 120.0):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    atoms = list(traj.topology.atoms)

    # bond map
    bond_map = {i: [] for i in range(len(atoms))}
    for a, b in traj.topology.bonds:
        bond_map[a.index].append(b.index)
        bond_map[b.index].append(a.index)

    is_water  = np.array([a.residue.name.strip() in {"HOH","WAT","SOL"} for a in atoms])
    # restrict ligand to this chain/resSeq/resname
    is_this_lig = _is_this_ligand_mask(atoms, ligand)
    is_rna = np.array([a.residue.is_nucleic for a in atoms])

    # Acceptors: N or O on RNA or THIS ligand (not water)
    acceptors = np.array([i for i,a in enumerate(atoms)
                          if a.element.symbol in ("N","O") and (is_rna[i] or is_this_lig[i]) and not is_water[i]], dtype=int)

    # Donors: heavy N/O/S with at least one H, on RNA or THIS ligand (not water)
    donors, hydrogens = [], []
    for i, a in enumerate(atoms):
        if is_water[i]:      continue
        if not (is_rna[i] or is_this_lig[i]):  continue
        if a.element.symbol not in ("N","O","S"): continue
        Hs = [h for h in bond_map[i] if atoms[h].element.symbol == "H"]
        if Hs:
            donors.extend([i]*len(Hs))
            hydrogens.extend(Hs)
    donors = np.array(donors, dtype=int)
    hydrogens = np.array(hydrogens, dtype=int)
    if donors.size == 0 or acceptors.size == 0:
        print(f"❗ {ligand.key}: no donors/acceptors after selection.")
        return

    triplets = np.array([(d,h,a) for d,h in zip(donors, hydrogens) for a in acceptors if a != d], dtype=np.int32)
    donor_idxs    = jnp.array(triplets[:,0]); hydrogen_idxs = jnp.array(triplets[:,1]); acceptor_idxs = jnp.array(triplets[:,2])

    ligand_atom_indices = jnp.array(ligand.atom_indices, dtype=jnp.int32)
    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices) | jnp.isin(acceptor_idxs, ligand_atom_indices)

    h_bonds_found = []
    n_frames = coords.shape[0]
    for frame_idx in tqdm(range(n_frames), desc=f"[{ligand.key}] H-bonds RNA"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                                  f"{a.residue.name} {a.residue.resSeq} ({a.name})"))

    with open(f"{out_prefix}hbond_summary.txt", "w") as f:
        for donor, acceptor in h_bonds_found:
            f.write(f"{donor} → {acceptor}\n")
    print(f"✅ {ligand.key}: H-bond summary saved as {out_prefix}hbond_summary.txt")

    # Top residues (skip ligand)
    from collections import Counter
    residue_counter = Counter()
    for donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand.resname):
                continue
            res_label = entry.split('(')[0].strip()
            residue_counter[res_label] += 1
    if residue_counter:
        df = pd.DataFrame(residue_counter.items(), columns=["Residue", "Count"]).sort_values("Count", ascending=False).reset_index(drop=True)
        plt.figure(figsize=(12, 6)); plt.bar(df["Residue"][:20], df["Count"][:20], color='skyblue')
        plt.title(f"Top 20 H-Bond Partners with {ligand.key}", fontsize=14)
        plt.xlabel("RNA Residue"); plt.ylabel("H-Bond Count"); plt.xticks(rotation=45, ha='right'); plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.6); plt.savefig(f"{out_prefix}hbond_top20_bar.png"); plt.close()

    # Roles
    donor_roles = Counter(); acceptor_roles = Counter()
    for donor, acceptor in h_bonds_found:
        if donor.startswith(ligand.resname):
            res = acceptor.split('(')[0].strip(); donor_roles[res] += 1
        elif acceptor.startswith(ligand.resname):
            res = donor.split('(')[0].strip(); acceptor_roles[res] += 1
    residues = list(set(donor_roles) | set(acceptor_roles))
    if residues:
        df_roles = pd.DataFrame({
            "Residue": residues,
            f"{ligand.key} as Donor":   [donor_roles.get(r, 0) for r in residues],
            f"{ligand.key} as Acceptor":[acceptor_roles.get(r, 0) for r in residues]
        }).sort_values([f"{ligand.key} as Donor", f"{ligand.key} as Acceptor"], ascending=False).head(20)
        df_roles.set_index("Residue").plot(kind="bar", stacked=True, figsize=(12, 6), colormap="viridis")
        plt.title(f"Top 20 H-Bond Partners – {ligand.key}", fontsize=14)
        plt.ylabel("Bond Count"); plt.xlabel("RNA Residue"); plt.xticks(rotation=45, ha='right'); plt.tight_layout()
        plt.grid(axis='y', linestyle='--', alpha=0.5); plt.savefig(f"{out_prefix}hbond_roles_top20_stacked.png"); plt.close()

    # Per-frame heatmap on top residues
    framewise_counts = defaultdict(lambda: defaultdict(int))
    if h_bonds_found:
        # recompute per-frame and count non‑ligand residues
        n_frames = coords.shape[0]
        for frame_idx in tqdm(range(n_frames), desc=f"[{ligand.key}] H-bond heatmap"):
            xyz = coords[frame_idx]
            d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
            vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
            vec_DH = h_xyz - d_xyz
            norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
            norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
            angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
            passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]  # FIXED variable name
            for idx in passed:
                d = atoms[int(donor_idxs[idx])]; a = atoms[int(acceptor_idxs[idx])]
                for atom in (d, a):
                    if atom.residue.name.strip() == ligand.resname:
                        continue
                    res_key = f"{atom.residue.name} {atom.residue.resSeq}"
                    framewise_counts[frame_idx][res_key] += 1

        total_counts = defaultdict(int)
        for frame_dict in framewise_counts.values():
            for res, count in frame_dict.items():
                total_counts[res] += count
        top_residues = sorted(total_counts, key=total_counts.get, reverse=True)[:20]
        heatmap_df = pd.DataFrame(index=range(n_frames), columns=top_residues).fillna(0)
        for frame_idx, res_counts in framewise_counts.items():
            for res in top_residues:
                if res in res_counts:
                    heatmap_df.at[frame_idx, res] = res_counts[res]
        plt.figure(figsize=(14, 6)); sns.heatmap(heatmap_df.T, cmap="YlGnBu", cbar_kws={'label': 'H-Bond Count'})
        plt.title(f"H-Bond Time Series per Residue (Top 20) – {ligand.key}"); plt.xlabel("Frame"); plt.ylabel("RNA Residue")
        plt.tight_layout(); plt.savefig(f"{out_prefix}hbond_heatmap.png"); plt.close()

    print(f"✅ {ligand.key}: RNA H-bond artifacts saved (txt, bars, roles, heatmap) with prefix {out_prefix}")

# 6b. H-Bond Analysis — Protein (per‑ligand core)
def run_hbond_analysis_protein_core(traj_file: str, top_file: str, ligand: LigandRef,
                                    out_prefix: str, dist_cutoff: float = 0.35, angle_cutoff: float = 120.0):
    traj = md.load_dcd(traj_file, top=top_file)
    atoms = list(traj.topology.atoms)
    coords = jnp.array(traj.xyz)

    # bond map
    bond_map = {i: [] for i in range(len(atoms))}
    for a, b in traj.topology.bonds:
        bond_map[a.index].append(b.index)
        bond_map[b.index].append(a.index)

    prot_resnames = {res.name for res in traj.topology.residues if res.name not in {"HOH","WAT","SOL", ligand.resname}}
    is_protein = np.array([a.residue.name.strip() in prot_resnames for a in atoms])
    is_this_lig = _is_this_ligand_mask(atoms, ligand)

    acceptors = np.array([i for i,a in enumerate(atoms)
                          if a.element.symbol in ("N","O") and (is_protein[i] or is_this_lig[i])], dtype=int)

    donors, hydrogens = [], []
    for i, a in enumerate(atoms):
        if not (is_protein[i] or is_this_lig[i]):
            continue
        if a.element.symbol not in ("N","O","S"):
            continue
        Hs = [h for h in bond_map[i] if atoms[h].element.symbol == "H"]
        if Hs:
            donors.extend([i]*len(Hs))
            hydrogens.extend(Hs)
    donors = np.array(donors, dtype=int)
    hydrogens = np.array(hydrogens, dtype=int)
    if donors.size == 0 or acceptors.size == 0:
        print(f"❗ {ligand.key}: no donors/acceptors in protein+ligand selection.")
        return

    triplets = []
    for d, h in zip(donors, hydrogens):
        for a in acceptors:
            if a != d:
                triplets.append((d,h,a))
    triplets = np.array(triplets, dtype=np.int32)

    donor_idxs    = jnp.array(triplets[:,0])
    hydrogen_idxs = jnp.array(triplets[:,1])
    acceptor_idxs = jnp.array(triplets[:,2])

    ligand_atom_indices = jnp.array(ligand.atom_indices, dtype=jnp.int32)
    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices) | jnp.isin(acceptor_idxs, ligand_atom_indices)

    h_bonds_found = []
    n_frames = coords.shape[0]
    for f in tqdm(range(n_frames), desc=f"[{ligand.key}] H-bonds PROT"):
        xyz = coords[f]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((f, f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                                     f"{a.residue.name} {a.residue.resSeq} ({a.name})"))

    with open(f"{out_prefix}protein_hbond_summary.txt", "w") as f:
        for frame, donor, acceptor in h_bonds_found:
            f.write(f"[frame {frame}] {donor} → {acceptor}\n")
    print(f"✅ {ligand.key}: Protein H-bond summary saved as {out_prefix}protein_hbond_summary.txt")

    from collections import Counter
    residue_counter = Counter()
    for _, donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand.resname): continue
            res_label = entry.split('(')[0].strip()
            residue_counter[res_label] += 1
    if residue_counter:
        df = pd.DataFrame(residue_counter.items(), columns=["Residue", "Count"]).sort_values("Count", ascending=False).reset_index(drop=True)
        plt.figure(figsize=(12, 6))
        plt.bar(df["Residue"][:20], df["Count"][:20], color='orange')
        plt.title(f"Top 20 Protein Residues H-Bonded with {ligand.key}", fontsize=14)
        plt.xlabel("Protein Residue"); plt.ylabel("H-Bond Count"); plt.xticks(rotation=45, ha='right')
        plt.tight_layout(); plt.grid(axis='y', linestyle='--', alpha=0.6)
        plt.savefig(f"{out_prefix}protein_hbond_top20_bar.png"); plt.close()

    donor_roles = Counter(); acceptor_roles = Counter()
    for _, donor, acceptor in h_bonds_found:
        if donor.startswith(ligand.resname):
            res = acceptor.split('(')[0].strip(); donor_roles[res] += 1
        elif acceptor.startswith(ligand.resname):
            res = donor.split('(')[0].strip(); acceptor_roles[res] += 1
    residues = list(set(donor_roles) | set(acceptor_roles))
    if residues:
        df_roles = pd.DataFrame({
            "Residue": residues,
            "Ligand as Donor": [donor_roles.get(r, 0) for r in residues],
            "Ligand as Acceptor": [acceptor_roles.get(r, 0) for r in residues]
        }).sort_values(["Ligand as Donor", "Ligand as Acceptor"], ascending=False).head(20)
        df_roles.set_index("Residue").plot(kind="bar", stacked=True, figsize=(12, 6), colormap="magma")
        plt.title(f"Top 20 H-Bond Partners – {ligand.key} as Donor vs Acceptor", fontsize=14)
        plt.ylabel("Bond Count"); plt.xlabel("Protein Residue"); plt.xticks(rotation=45, ha='right')
        plt.tight_layout(); plt.grid(axis='y', linestyle='--', alpha=0.5)
        plt.savefig(f"{out_prefix}protein_hbond_roles_top20_stacked.png"); plt.close()

    # heatmap
    framewise_counts = defaultdict(lambda: defaultdict(int))
    n_frames = coords.shape[0]
    for frame_idx in tqdm(range(n_frames), desc=f"[{ligand.key}] PROT H-bond heatmap"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        angles = jnp.degrees(jnp.arccos(jnp.clip(jnp.sum(norm_DH * norm_HA, axis=1), -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            for atom in [d, a]:
                if atom.residue.name.strip() == ligand.resname:
                    continue
                res_key = f"{atom.residue.name} {atom.residue.resSeq}"
                framewise_counts[frame_idx][res_key] += 1

    total_counts = defaultdict(int)
    for frame_dict in framewise_counts.values():
        for res, count in frame_dict.items():
            total_counts[res] += count
    top_residues = sorted(total_counts, key=total_counts.get, reverse=True)[:20]
    if top_residues:
        heatmap_df = pd.DataFrame(index=range(n_frames), columns=top_residues).fillna(0)
        for frame_idx, res_counts in framewise_counts.items():
            for res in top_residues:
                if res in res_counts:
                    heatmap_df.at[frame_idx, res] = res_counts[res]
        plt.figure(figsize=(14, 6))
        sns.heatmap(heatmap_df.T, cmap="YlOrBr", cbar_kws={'label': 'H-Bond Count'})
        plt.title(f"Protein H-Bond Time Series (Top 20) – {ligand.key}")
        plt.xlabel("Frame"); plt.ylabel("Protein Residue"); plt.tight_layout()
        plt.savefig(f"{out_prefix}protein_hbond_heatmap.png"); plt.close()

    print(f"✅ {ligand.key}: protein H-bond plots saved (prefix {out_prefix})")

# 9. Ligand–RNA Atom Contact Frequencies (per‑ligand core)
def run_ligand_rna_atom_contact_frequencies_core(traj_file: str, top_file: str, ligand: LigandRef, out_prefix: str):
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    atoms = list(traj.topology.atoms)
    # bond map
    bond_map = {i: [] for i in range(len(atoms))}
    for bond in traj.topology.bonds:
        bond_map[bond[0].index].append(bond[1].index)
        bond_map[bond[1].index].append(bond[0].index)

    rna_bases = {"A","U","G","C"}
    acceptors = [a for a in atoms if a.element.symbol in ['N','O'] and a.residue.name.strip() in rna_bases]
    acceptor_indices_set = set(a.index for a in acceptors)

    # build donor-H-acceptor triplets for RNA + this ligand only
    triplets_np = []
    is_this_lig = _is_this_ligand_mask(atoms, ligand)
    for h in atoms:
        if h.element.symbol != 'H':
            continue
        resname = h.residue.name.strip()
        if (resname not in rna_bases) and (not is_this_lig[h.index]):
            continue
        bonded = bond_map[h.index]
        if not bonded:
            continue
        d_idx = bonded[0]
        for a_idx in acceptor_indices_set:
            if a_idx != d_idx:
                triplets_np.append((d_idx, h.index, a_idx))
    if not triplets_np:
        print(f"❗ {ligand.key}: no candidate triplets for H-bond contact frequency.")
        return

    triplets_np = np.array(triplets_np, dtype=np.int32)
    triplets = jnp.array(triplets_np)
    donor_idxs    = triplets[:,0]
    hydrogen_idxs = triplets[:,1]
    acceptor_idxs = triplets[:,2]

    ligand_atom_indices = jnp.array(ligand.atom_indices)
    involves_ligand_mask = jnp.isin(donor_idxs, ligand_atom_indices) | jnp.isin(acceptor_idxs, ligand_atom_indices)

    h_bonds_found = []
    dist_cutoff = 0.35; angle_cutoff = 120.0
    n_frames = coords.shape[0]
    for frame_idx in tqdm(range(n_frames), desc=f"[{ligand.key}] H-bonds RNA for atom freq"):
        xyz = coords[frame_idx]
        d_xyz = xyz[donor_idxs]; h_xyz = xyz[hydrogen_idxs]; a_xyz = xyz[acceptor_idxs]
        vec_HA = h_xyz - a_xyz; dist_HA = jnp.linalg.norm(vec_HA, axis=1)
        vec_DH = h_xyz - d_xyz
        norm_DH = vec_DH / jnp.linalg.norm(vec_DH, axis=1)[:, None]
        norm_HA = vec_HA / jnp.linalg.norm(vec_HA, axis=1)[:, None]
        cos_angle = jnp.sum(norm_DH * norm_HA, axis=1)
        angles = jnp.degrees(jnp.arccos(jnp.clip(cos_angle, -1.0, 1.0)))
        passed = jnp.where((dist_HA < dist_cutoff) & (angles > angle_cutoff) & involves_ligand_mask)[0]
        for idx in passed:
            d = atoms[int(donor_idxs[idx])]
            a = atoms[int(acceptor_idxs[idx])]
            h_bonds_found.append((f"{d.residue.name} {d.residue.resSeq} ({d.name})",
                                  f"{a.residue.name} {a.residue.resSeq} ({a.name})"))

    if not h_bonds_found:
        print(f"❗ {ligand.key}: no ligand–RNA H-bonds found.")
        return

    # tally RNA atom contacts (skip ligand rows)
    from collections import defaultdict
    import re
    atom_contact_counts = defaultdict(int)
    for donor, acceptor in h_bonds_found:
        for entry in (donor, acceptor):
            if entry.startswith(ligand.resname):
                continue
            m = re.match(r"([AUGC])\s\d+\s\((\w+)\)", entry)
            if m:
                base, atom = m.groups()
                atom_contact_counts[f"{base}-{atom}"] += 1

    df = pd.DataFrame(atom_contact_counts.items(), columns=["RNA Atom", "Contact Count"]).sort_values("Contact Count", ascending=False).reset_index(drop=True)
    print(f"🔹 Most Frequently Contacted RNA Atoms by {ligand.key}:")
    print(df.head(30).to_string(index=False))
    df.to_csv(f"{out_prefix}ligand_rna_atom_contact_frequencies.csv", index=False)
    print(f"✅ {ligand.key}: saved to '{out_prefix}ligand_rna_atom_contact_frequencies.csv'")

# 10. Carboxylate–OP checker (per‑ligand core)
def run_carboxylate_OP_checker_core(traj_file: str, top_file: str, ligand: LigandRef, out_prefix: str):
    traj = md.load_dcd(traj_file, top=top_file)
    atoms = list(traj.topology.atoms)

    carboxylate_O_names = {"O","OXT","O1","O2"}  # permissive, still filtered by THIS ligand
    ligand_O_idxs = [i for i in ligand.atom_indices if atoms[i].name.strip() in carboxylate_O_names or atoms[i].element.symbol == "O"]
    if not ligand_O_idxs:
        print(f"❗ {ligand.key}: no carboxylate O atoms detected; skipping.")
        return

    rna_bases = {"A","U","G","C"}; phos_names = {"OP1","OP2"}
    rna_OP_idxs = []
    rna_OP_labels = []
    for atom in atoms:
        if atom.residue.name.strip() in rna_bases and atom.name.strip() in phos_names:
            rna_OP_idxs.append(atom.index)
            rna_OP_labels.append(f"{atom.residue.name.strip()}{atom.residue.resSeq}-{atom.name.strip()}")

    coords = jnp.array(traj.xyz)
    ligand_coords = coords[:, ligand_O_idxs, :]
    rna_OP_coords = coords[:, rna_OP_idxs, :]
    n_frames = coords.shape[0]

    threshold = 0.35
    contact_matrix = np.zeros((n_frames, len(rna_OP_idxs)), dtype=int)
    print(f"[{ligand.key}] Computing contacts (carboxylate O ↔ OP1/OP2)...")
    for f in tqdm(range(n_frames)):
        for li in range(len(ligand_O_idxs)):
            dists = jnp.linalg.norm(rna_OP_coords[f] - ligand_coords[f, li], axis=1)
            contact_matrix[f] = np.logical_or(contact_matrix[f], dists < threshold)

    occupancy = contact_matrix.sum(axis=0) / n_frames
    np.save(out_prefix + "contact_matrix.npy", contact_matrix)
    np.save(out_prefix + "occupancy.npy", occupancy)
    with open(out_prefix + "labels.txt", "w") as f:
        for label in rna_OP_labels:
            f.write(label + "\n")

    plt.figure(figsize=(14, 3))
    sns.heatmap(contact_matrix.T, cmap="Blues", cbar=True, yticklabels=rna_OP_labels)
    plt.title(f"{ligand.key}: Carboxylate–RNA OP1/OP2 Contacts (framewise)")
    plt.xlabel("Frame"); plt.ylabel("RNA OP1/OP2 Atom")
    plt.tight_layout(); plt.savefig(out_prefix + "contact_heatmap.png", dpi=200); plt.close()

    plt.figure(figsize=(16, 4))
    sns.barplot(x=rna_OP_labels, y=occupancy)
    plt.xticks(rotation=90); plt.ylabel("Contact Occupancy (fraction)")
    plt.title(f"{ligand.key}: Carboxylate Contact with RNA OP1/OP2")
    plt.tight_layout(); plt.savefig(out_prefix + "occupancy.png", dpi=200); plt.close()

    print("\nTop 10 ligand–OP contacts by occupancy:")
    for label_, occ in sorted(list(zip(rna_OP_labels, occupancy)), key=lambda x: x[1], reverse=True)[:10]:
        print(f'{label_}: {occ:.3f}')
    print(f"✅ {ligand.key}: carboxylate–OP checker complete (prefix '{out_prefix}')")

# 12. π–π stacking (per‑ligand core)
def run_pi_pi_stacking_core(traj_file: str, top_file: str, ligand: LigandRef,
                            ligand_ring_defs: List[List[str]], out_prefix: str):
    """
    ligand_ring_defs: list of rings; each ring is list of atom names (strings) in the ligand.
    """
    traj = md.load_dcd(traj_file, top=top_file)
    coords = jnp.array(traj.xyz)
    n_frames = coords.shape[0]; top = traj.topology

    # RNA hexagon ring indices per base
    hexagon_ring_atoms = {"N1","C2","N3","C4","C5","C6"}
    rna_ring_map = []
    for res in top.residues:
        base = res.name.strip()
        if base in {"A","G","C","U"}:
            for a in res.atoms:
                if a.name.strip() in hexagon_ring_atoms:
                    rna_ring_map.append((res.index, base, a.name.strip(), a.index))
    rna_df = pd.DataFrame(rna_ring_map, columns=["res_index","base","atom","atom_index"])
    rna_base_ring_idxs = []
    rna_base_ring_labels = []
    rna_base_pdbinfo = []
    for res_index in rna_df["res_index"].unique():
        sub = rna_df[rna_df["res_index"] == res_index]
        if len(sub) == 6:
            idxs = sub.sort_values("atom")["atom_index"].tolist()
            atom0 = top.atom(int(sub.iloc[0]["atom_index"]))
            chain = _chain_id_of(atom0)
            base = atom0.residue.name.strip()
            resSeq = atom0.residue.resSeq
            label = f"{base}{resSeq}"
            rna_base_ring_idxs.append(idxs); rna_base_ring_labels.append(label)
            rna_base_pdbinfo.append((chain, base, resSeq, label))

    # Ligand ring indices for THIS ligand only
    lig_name_to_idx = {a.name.strip(): a.index for a in top.atoms
                       if a.residue.name.strip() == ligand.resname and int(a.residue.resSeq)==ligand.resSeq and _chain_id_of(a)==ligand.chain_id}
    ligand_ring_idxs = []
    for ring in ligand_ring_defs:
        try:
            ligand_ring_idxs.append([lig_name_to_idx[nm] for nm in ring])
        except KeyError as e:
            print(f"❗ {ligand.key}: ring atom not found in ligand: {e}; skipping π–π analysis for this ligand.")
            return

    def _centroid_normal(rcoords):
        c = jnp.mean(rcoords, axis=0)
        v1 = rcoords[1] - rcoords[0]; v2 = rcoords[2] - rcoords[0]
        n = jnp.cross(v1, v2); n = n / (jnp.linalg.norm(n) + 1e-12)
        return c, n

    distance_cutoff = 0.60; angle_cutoff_deg = 30.0
    events = []
    for f in tqdm(range(n_frames), desc=f"[{ligand.key}] π–π"):
        for lidx, lring in enumerate(ligand_ring_idxs):
            l_coords = coords[f, lring, :]
            l_centroid, l_normal = _centroid_normal(l_coords)
            for ridx, rring in enumerate(rna_base_ring_idxs):
                r_coords = coords[f, rring, :]
                r_centroid, r_normal = _centroid_normal(r_coords)
                dist = jnp.linalg.norm(l_centroid - r_centroid)
                ang = jnp.degrees(jnp.arccos(jnp.clip(jnp.dot(l_normal, r_normal), -1.0, 1.0)))
                if (dist <= distance_cutoff) and (ang <= angle_cutoff_deg or ang >= 180-angle_cutoff_deg):
                    chain, base, resSeq, label = rna_base_pdbinfo[ridx]
                    events.append((f, lidx, ridx, float(dist), float(ang), chain, base, resSeq, label))

    df = pd.DataFrame(events, columns=["frame","ligand_ring","rna_base_index","distance","angle","chain","base","resSeq","pdb_label"])
    df.to_csv(out_prefix + "stacking_events_PDBlabels.csv", index=False)
    print(f"✅ {ligand.key}: saved {out_prefix}stacking_events_PDBlabels.csv")
    if not df.empty:
        counts = df["pdb_label"].value_counts().sort_index()
        plt.figure(figsize=(14,4)); plt.bar(counts.index, counts.values)
        plt.xticks(rotation=90); plt.ylabel("Stacking Events")
        plt.title(f"π–π Stacking Events vs RNA (PDB numbering) – {ligand.key}")
        plt.tight_layout(); plt.savefig(out_prefix + "stacking_events_PDBlabels_barplot.png", dpi=150); plt.close()
    else:
        print(f"[{ligand.key}] No π–π stacking events under current cutoffs.")

# =========================== MULTI‑LIGAND WRAPPERS ============================
# Each wrapper:
#   - builds/uses a LigandRegistry
#   - iterates selected ligands
#   - calls the corresponding *core* with a per‑ligand out_prefix "…/<base>_{lig.key}_…"

def multi_run_ligand_rmsd(top_file: str, traj_file: str, registry: LigandRegistry,
                          select: Optional[Iterable[str]] = None, out_prefix: str = ""):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_ligand_rmsd_core(traj_file, top_file, lig.atom_indices, pref, lig.key)

def multi_run_hydration_shell(top_file: str, traj_file: str, registry: LigandRegistry,
                              select: Optional[Iterable[str]] = None, out_prefix: str = "", dist_cutoff: float = 0.35):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_hydration_shell_core(traj_file, top_file, lig.atom_indices, pref, lig.key, dist_cutoff=dist_cutoff)

def multi_run_contact_analysis_rna(top_file: str, traj_file: str, registry: LigandRegistry,
                                   select: Optional[Iterable[str]] = None, out_prefix: str = "", cutoff: float = 0.40):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_contact_analysis_rna_core(traj_file, top_file, lig.atom_indices, pref, lig.key, cutoff=cutoff)

def multi_run_contact_analysis_protein(top_file: str, traj_file: str, registry: LigandRegistry,
                                       select: Optional[Iterable[str]] = None, out_prefix: str = "", cutoff: float = 0.40):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_contact_analysis_protein_core(traj_file, top_file, lig.atom_indices, pref, lig.key, cutoff=cutoff)

def multi_run_hbond_analysis_rna(top_file: str, traj_file: str, registry: LigandRegistry,
                                 select: Optional[Iterable[str]] = None, out_prefix: str = "",
                                 dist_cutoff: float = 0.35, angle_cutoff: float = 120.0):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_hbond_analysis_rna_core(traj_file, top_file, lig, pref, dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff)

def multi_run_hbond_analysis_protein(top_file: str, traj_file: str, registry: LigandRegistry,
                                     select: Optional[Iterable[str]] = None, out_prefix: str = "",
                                     dist_cutoff: float = 0.35, angle_cutoff: float = 120.0):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_hbond_analysis_protein_core(traj_file, top_file, lig, pref, dist_cutoff=dist_cutoff, angle_cutoff=angle_cutoff)

def multi_run_ligand_rna_atom_contact_frequencies(top_file: str, traj_file: str, registry: LigandRegistry,
                                                  select: Optional[Iterable[str]] = None, out_prefix: str = ""):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_ligand_rna_atom_contact_frequencies_core(traj_file, top_file, lig, pref)

def multi_run_carboxylate_OP_checker(top_file: str, traj_file: str, registry: LigandRegistry,
                                     select: Optional[Iterable[str]] = None, out_prefix: str = "carboxylate_OP_"):
    for lig in registry.select(select):
        pref = _prefix_for(out_prefix, lig)
        run_carboxylate_OP_checker_core(traj_file, top_file, lig, pref)

def multi_run_pi_pi_stacking(top_file: str, traj_file: str, registry: LigandRegistry,
                             ligand_ring_defs: Dict[str, List[List[str]]] | List[List[str]],
                             select: Optional[Iterable[str]] = None, out_prefix: str = "pi_pi_"):
    """
    ligand_ring_defs:
      - If dict: keys are registry keys (lig.key), values are ring-def lists for that ligand
      - If list: used for all ligands uniformly
    """
    use_dict = isinstance(ligand_ring_defs, dict)
    for lig in registry.select(select):
        defs = ligand_ring_defs[lig.key] if use_dict else ligand_ring_defs
        pref = _prefix_for(out_prefix, lig)
        run_pi_pi_stacking_core(traj_file, top_file, lig, defs, pref)


